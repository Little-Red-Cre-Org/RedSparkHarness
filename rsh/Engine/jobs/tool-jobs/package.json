{
  "name": "@redspark/rsh-tool-jobs",
  "description": "Model-facing background job control tools (job_output, job_list, job_kill) over the ctx.jobs registry",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/jobs/tool-jobs"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-output-retention": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-jobs": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-output-retention": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-jobs": "workspace:^",
    "@redspark/rsh-jobs-local": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/cordis": "workspace:^"
  }
}
