{
  "name": "@redspark/rsh-jobs-local",
  "description": "Process-local implementation of the RedSpark Harness background job registry seam",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/jobs/jobs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-jobs": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "dependencies": {
    "@redspark/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis-plugin-include": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop-testkit": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-jobs": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/cordis": "workspace:^"
  }
}
