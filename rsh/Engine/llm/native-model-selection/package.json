{
  "dsh": {
    "native": {
      "optional": [],
      "requires": [
        "activeSessions",
        "agents",
        "modelDirectory"
      ],
      "targets": [
        "host"
      ],
      "apiVersion": 1,
      "provides": [
        "modelSelection"
      ],
      "entry": "./native"
    }
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    }
  },
  "devDependencies": {
    "@redspark/rsh-agent-instructions": "workspace:^",
    "typescript": "^6.0.3",
    "@redspark/rsh-native-headless": "workspace:^",
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-brand": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-model-execution": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^"
  },
  "name": "@redspark/rsh-native-model-selection",
  "types": "lib/types/index.d.ts",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/llm/native-model-selection"
  },
  "publishConfig": {
    "access": "public"
  },
  "version": "1.0.0",
  "description": "Native Session-local model selection and immutable step routes",
  "type": "module",
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/types.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ]
}
