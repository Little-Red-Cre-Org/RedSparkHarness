{
  "name": "@redspark/rsh-token-meter",
  "description": "Replay-aware token measurement service (ctx.tokenMeter) for the RedSpark Harness",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/llm/token-meter"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-compaction": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-llm-retry": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.4.3",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-model-execution": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-compaction": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-llm-retry": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^"
  },
  "dsh": {
    "native": {
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "model"
      ],
      "provides": [
        "tokenMeter"
      ],
      "apiVersion": 1,
      "optional": []
    }
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-compaction": {
      "optional": true
    },
    "@redspark/rsh-llm-retry": {
      "optional": true
    },
    "@redspark/rsh-session-projection": {
      "optional": true
    }
  }
}
