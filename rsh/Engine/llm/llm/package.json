{
  "name": "@redspark/rsh-llm",
  "description": "Provider-neutral LLM service interface for the RedSpark Harness",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/llm/llm"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./brand": {
      "types": "./lib/types/brand.d.ts",
      "default": "./lib/types/brand.js"
    },
    "./message": {
      "types": "./lib/types/message.d.ts",
      "default": "./lib/types/message.js"
    },
    "./assistant-stream": {
      "types": "./lib/types/assistant-stream.d.ts",
      "default": "./lib/types/assistant-stream.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^",
    "@redspark/rsh-errors": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/rsh-typert-protocol": { "optional": true },
    "@redspark/cordis": { "optional": true }
  },
  "dependencies": {
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-util-crypto": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.4.3",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-typert-protocol": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-errors": "workspace:^"
  }
}
