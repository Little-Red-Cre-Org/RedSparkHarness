{
  "name": "@redspark/rsh-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the RedSpark Harness",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./display": {
      "types": "./lib/types/display.d.ts",
      "default": "./lib/types/display.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./settings-namespace": {
      "types": "./lib/types/settings-namespace.d.ts",
      "default": "./lib/types/settings-namespace.js"
    },
    "./native-definition": {
      "types": "./lib/types/native-definition.d.ts",
      "default": "./lib/types/native-definition.js"
    },
    "./selection": {
      "types": "./lib/types/selection.d.ts",
      "default": "./lib/selection.js"
    },
    "./compat-settings": {
      "types": "./lib/types/compat-settings.d.ts",
      "default": "./lib/compat-settings.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/native.js",
    "presets",
    "lib/selection.js",
    "lib/compat-settings.js",
    "lib/settings-owner-*.js",
    "lib/shared-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis-plugin-include": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-atomic-write": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-home-paths": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-settings-definition": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^4.3.2",
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.4.3",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis-plugin-group": "workspace:^",
    "@redspark/cordis-plugin-include": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-atomic-write": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-home-paths": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-settings": "workspace:^",
    "@redspark/rsh-compat-settings-adapters": "workspace:^",
    "@redspark/rsh-settings-definition": "workspace:^",
    "@redspark/rsh-settings-file": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis-plugin-include": {
      "optional": true
    },
    "@redspark/cordis-plugin-loader": {
      "optional": true
    },
    "@redspark/rsh-agent": {
      "optional": true
    },
    "@redspark/rsh-atomic-write": {
      "optional": true
    },
    "@redspark/rsh-invariants": {
      "optional": true
    },
    "@redspark/rsh-home-paths": {
      "optional": true
    },
    "@redspark/rsh-scope": {
      "optional": true
    },
    "@redspark/rsh-session-projection": {
      "optional": true
    },
    "@redspark/rsh-system-prompt": {
      "optional": true
    },
    "@redspark/rsh-tools": {
      "optional": true
    },
    "@redspark/rsh-typert-protocol": {
      "optional": true
    },
    "@redspark/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "provides": [
        "agentPresets"
      ],
      "requires": [],
      "optional": [
        "settings"
      ]
    }
  }
}
