{
  "formatVersion": 1,
  "installations": [
    {
      "id": "persona",
      "plugin": "@redspark/rsh-native-persona",
      "config": {
        "prefix": "You are a coding agent powered by the {{model}} model.",
        "suffix": "Your working directory is {{cwd}}."
      }
    },
    {
      "id": "code-tool",
      "plugin": "@redspark/rsh-tool-code-runtime",
      "config": {
        "sdkPrompt": true,
        "presentation": "ptc",
        "denyTools": [
          "workflow"
        ]
      }
    }
  ]
}
