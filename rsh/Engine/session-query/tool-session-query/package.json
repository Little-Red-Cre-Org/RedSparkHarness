{
  "name": "@redspark/rsh-tool-session-query",
  "description": "Workspace-authorized model-facing session history search, trace, and event read tools",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/session-query/tool-session-query"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-session-query": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-native-prompt": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-session-query": "workspace:^",
    "@redspark/rsh-session-query-sqlite": "workspace:^",
    "@redspark/rsh-session-title": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/rsh-tool-call-timeout-policy": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-native-prompt": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/rsh-native-runtime": {
      "optional": true
    },
    "@redspark/rsh-native-tools": {
      "optional": true
    },
    "@redspark/rsh-native-prompt": {
      "optional": true
    },
    "@redspark/rsh-native-agent": {
      "optional": true
    },
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-agent": {
      "optional": true
    },
    "@redspark/rsh-system-prompt": {
      "optional": true
    },
    "@redspark/rsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "sessionQuery",
        "sessionProjections",
        "tools",
        "promptSections"
      ],
      "provides": [],
      "optional": []
    }
  }
