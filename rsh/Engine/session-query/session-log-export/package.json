{
  "name": "@redspark/rsh-session-log-export",
  "description": "Session-log archive streams for Web downloads and Native Host consumers",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/session-query/session-log-export"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/client.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-session-format": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "fflate": "^0.8.2",
    "@redspark/rsh-brand": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-session-query": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-client-connection": "workspace:^",
    "@redspark/rsh-client-locale": "workspace:^",
    "@redspark/rsh-client-store": "workspace:^",
    "@redspark/rsh-client-ui-commands": "workspace:^",
    "@redspark/rsh-client-ui-conversation": "workspace:^",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "@redspark/rsh-client-ui-renderer": "workspace:^",
    "@redspark/rsh-client-ui-session": "workspace:^",
    "@redspark/rsh-client-ui-slots": "workspace:^",
    "@redspark/rsh-commands": "workspace:^",
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-native-headless": "workspace:^",
    "@redspark/rsh-native-model-execution": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-session-query": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "sessionQuery",
        "sessionPersistence",
        "attachments",
        "activeSessions"
      ],
      "optional": [],
      "provides": [
        "sessionLogExport"
      ]
    },
    "client": {
      "inject": [
        "@redspark/rsh-client-locale",
        "@redspark/rsh-client-ui-commands",
        "@redspark/rsh-client-ui-conversation",
        "@redspark/rsh-client-ui-renderer",
        "@redspark/rsh-client-ui-session"
      ],
      "platform": "web"
    }
  }
}
