{
  "name": "@redspark/rsh-session-query-sqlite",
  "description": "Concrete ctx.sessionQuery backend with SQLite FTS5 search",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/session-query/session-query-sqlite"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/types/core.d.ts",
      "default": "./lib/core.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/core.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-session-query": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-session-projection-cache": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-session-persistence": {
      "optional": true
    },
    "@redspark/rsh-native-runtime": {
      "optional": true
    },
    "@redspark/rsh-native-session-execution": {
      "optional": true
    },
    "@redspark/rsh-session-projection": {
      "optional": true
    },
    "@redspark/rsh-session-projection-cache": {
      "optional": true
    }
  },
  "dependencies": {
    "@redspark/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-session-query": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-session-projection-cache": "workspace:^"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": ["host"],
      "requires": ["activeSessions"],
      "optional": ["sessionPersistence", "sessionProjections", "sessionProjectionCache"],
      "provides": ["sessionQuery"]
    }
  }
}
