{
  "name": "@redspark/rsh-goal",
  "description": "Event-sourced same-session goal state and lifecycle service for the RedSpark Harness",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/goal/goal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./compatibility-events": {
      "types": "./lib/types/compatibility-events.d.ts",
      "default": "./lib/types/compatibility-events.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./facts": {
      "types": "./lib/types/facts.d.ts",
      "default": "./lib/types/facts.js"
    },
    "./projection": {
      "types": "./lib/types/projection.d.ts",
      "default": "./lib/projection.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/native.js",
    "lib/projection.js",
    "lib/shared-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-agent-loop-testkit": "workspace:^",
    "@redspark/rsh-bash-local": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-loader-smoke": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-checkpoint-policy": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-subprocess-local": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "agents",
        "activeSessions"
      ],
      "provides": [
        "goals"
      ],
      "optional": []
    }
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-agent": {
      "optional": true
    },
    "@redspark/rsh-invariants": {
      "optional": true
    },
    "@redspark/rsh-scope": {
      "optional": true
    },
    "@redspark/rsh-session-projection": {
      "optional": true
    },
    "@redspark/rsh-typert-protocol": {
      "optional": true
    }
  }
}
