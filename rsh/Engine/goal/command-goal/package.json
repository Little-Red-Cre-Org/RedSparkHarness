{
  "name": "@redspark/rsh-command-goal",
  "description": "Human-facing slash command for persisted same-session goals",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/goal/command-goal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-agent-loop-testkit": "workspace:^",
    "@redspark/rsh-commands": "workspace:^",
    "@redspark/rsh-goal": "workspace:^",
    "@redspark/rsh-goal-round-driver": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-commands": "workspace:^",
    "@redspark/rsh-goal": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-brand": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "commands",
        "goals"
      ],
      "provides": [],
      "optional": [
        "goalContinuation"
      ]
    }
  }
}
