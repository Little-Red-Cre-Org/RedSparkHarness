{
  "name": "@deepseek-ai/dsh-native-prompt",
  "description": "Scoped native prompt-section registry",
  "version": "0.1.5-rc.2",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "rsh/Engine/core/native-prompt" },
  "type": "module",
  "dsh": { "native": { "apiVersion": 1, "entry": "./native", "targets": ["host"], "requires": [], "optional": [], "provides": ["promptSections"] } },
  "main": "lib/index.js",
