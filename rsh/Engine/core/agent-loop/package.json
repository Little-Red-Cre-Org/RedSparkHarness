{
  "name": "@redspark/rsh-agent-loop",
  "description": "The concrete agent loop plugin for the RedSpark Harness",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/core/agent-loop"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./compat-settings": {
      "types": "./lib/types/compat-settings.d.ts",
      "default": "./lib/compat-settings.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/compat-settings.js",
    "lib/settings-owner-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tools": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-llm-pi-ai": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-compat-settings-adapters": "workspace:^",
    "@redspark/rsh-settings": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tools": "workspace:^"
  }
}
