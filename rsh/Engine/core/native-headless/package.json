{
  "name": "@redspark/rsh-native-headless",
  "description": "Native headless Agent composition for RedSpark Harness",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/core/native-headless"
  },
  "type": "module",
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "fs",
        "sessionPersistence",
        "modelExecution",
        "agents"
      ],
      "optional": [
        "tools",
        "promptSections",
        "sandboxPolicy",
        "approval",
        "codeRuntime",
        "timeContext",
        "tmuxContext",
        "sessionExecution",
        "activeSessions",
        "modelSelection",
        "agentPresets",
        "workspaceRegistry",
        "agentInstructions",
        "attachments",
        "requestContexts"
      ],
      "provides": [
        "application",
        "rootExecution"
      ]
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./lifecycle-events": {
      "types": "./lib/types/lifecycle-events.d.ts",
      "default": "./lib/lifecycle-events.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts",
    "lib/lifecycle-events.js"
  ],
  "license": "MIT",
  "devDependencies": {
    "@redspark/rsh-tool-code-runtime": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-token-meter": "workspace:^",
    "@redspark/rsh-native-approval": "workspace:^",
    "@redspark/rsh-native-code-runtime": "workspace:^",
    "@redspark/rsh-native-file-reference-local": "workspace:^",
    "@redspark/rsh-native-subagent": "workspace:^",
    "@redspark/rsh-request-context": "workspace:^",
    "@redspark/rsh-file-reference": "workspace:^",
    "@redspark/rsh-skill": "workspace:^",
    "@redspark/rsh-skill-filesystem": "workspace:^",
    "@redspark/rsh-tool-fs": "workspace:^",
    "@redspark/rsh-tool-skill": "workspace:^",
    "@redspark/rsh-tool-subagent": "workspace:^",
    "@redspark/rsh-llm-retry": "workspace:^",
    "@redspark/rsh-tool-call-timeout-policy": "workspace:^",
    "@redspark/rsh-repeat-tool-reminder": "workspace:^",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-native-prompt": "workspace:^",
    "@redspark/rsh-native-sandbox-policy": "workspace:^",
    "@redspark/rsh-approval-definition": "workspace:^",
    "@redspark/rsh-code-runtime-definition": "workspace:^",
    "@redspark/rsh-native-time-context": "workspace:^",
    "@redspark/rsh-tmux-context-definition": "workspace:^",
    "@redspark/rsh-native-model-execution": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/rsh-agent-presets": "workspace:^",
    "@redspark/rsh-workspace": "workspace:^",
    "@redspark/rsh-workspace-definition": "workspace:^",
    "@redspark/rsh-native-model-selection": "workspace:^",
    "@redspark/rsh-agent-instructions": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-request-context-definition": "workspace:^"
  }
}
