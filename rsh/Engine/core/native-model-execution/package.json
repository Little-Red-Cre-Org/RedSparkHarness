{
  "name": "@deepseek-ai/dsh-native-model-execution",
  "description": "Native model stream execution and Session recording",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "rsh/Engine/core/native-model-execution"
  },
  "type": "module",
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "model"
      ],
      "optional": [],
      "provides": [
        "modelExecution"
      ]
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./package.json": "./package.json",
    "./model-selection": {
      "types": "./lib/types/model-selection.d.ts",
      "default": "./lib/model-selection.js"
    },
    "./model-directory": {
      "types": "./lib/types/model-directory.d.ts",
      "default": "./lib/model-directory.js"
    },
    "./adapter-directory": {
      "types": "./lib/types/adapter-directory.d.ts",
      "default": "./lib/adapter-directory.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/model-selection.js",
    "lib/model-directory.js",
    "lib/adapter-directory.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-native-runtime": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-util-values": "workspace:^"
  }
}
