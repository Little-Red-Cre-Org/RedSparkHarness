{
  "name": "@redspark/rsh-agent-default-model",
  "description": "Default model selection shared by Agent entry points",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/core/agent-default-model"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./compat-settings": {
      "types": "./lib/types/compat-settings.d.ts",
      "default": "./lib/compat-settings.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./native-definition": {
      "types": "./lib/types/native-definition.d.ts",
      "default": "./lib/types/native-definition.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/compat-settings.js",
    "lib/settings-owner-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-settings-definition": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-settings-definition": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-settings": "workspace:^",
    "@redspark/rsh-compat-settings-adapters": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [],
      "optional": [
        "settings"
      ],
      "provides": [
        "agentDefaultModel"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-agent": {
      "optional": true
    },
    "@redspark/rsh-settings-definition": {
      "optional": true
    },
    "@redspark/rsh-llm": {
      "optional": true
    }
  }
}
