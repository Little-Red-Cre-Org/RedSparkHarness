{
  "name": "@redspark/rsh-agent-default-model",
  "description": "Default model selection shared by Agent entry points",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/core/agent-default-model"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./compat-settings": {
      "types": "./lib/types/compat-settings.d.ts",
      "default": "./lib/compat-settings.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/compat-settings.js",
    "lib/settings-owner-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-settings-definition": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-settings-definition": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-settings": "workspace:^",
    "@redspark/rsh-compat-settings-adapters": "workspace:^",
    "@redspark/cordis": "workspace:^"
  }
}
