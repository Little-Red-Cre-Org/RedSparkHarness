{
  "name": "@redspark/rsh-approval-definition",
  "description": "Framework-free approval identities, event vocabulary and consumer operations",
  "version": "1.0.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/core/approval-definition"
  },
  "type": "module",
  "dsh": { "runtime": { "apiVersion": 1, "role": "definition", "capability": "approval" } },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./legacy": { "types": "./lib/types/legacy.d.ts", "default": "./lib/legacy.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/legacy.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-session": "workspace:^"
  }
}
