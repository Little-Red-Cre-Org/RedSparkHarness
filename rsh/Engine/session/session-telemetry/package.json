{
  "name": "@redspark/rsh-session-telemetry",
  "description": "SessionTelemetryBackend seam for the RedSpark Harness: session-event capture, projection, redaction, and handoff to a reporting backend",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/session/session-telemetry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./records": {
      "types": "./lib/types/records.d.ts",
      "default": "./lib/records.js"
    },
    "./native-definition": {
      "types": "./lib/types/native-definition.d.ts",
      "default": "./lib/types/native-definition.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/records.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-command-feedback": "workspace:^",
    "@redspark/rsh-message-feedback": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/rsh-agent": { "optional": true },
    "@redspark/cordis": { "optional": true }
  },
  "devDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-command-feedback": "workspace:^",
    "@redspark/rsh-message-feedback": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "scripts": { "bundle": "tsdown" }
}
