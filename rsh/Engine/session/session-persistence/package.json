{
  "name": "@redspark/rsh-session-persistence",
  "description": "Abstract durable session persistence seam (ctx.sessionPersistence) for the RedSpark Harness",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/session/session-persistence"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./deletion": {
      "types": "./lib/types/deletion.d.ts",
      "default": "./lib/deletion.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/deletion.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  }
}
