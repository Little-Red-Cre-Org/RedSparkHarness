{
  "name": "@redspark/rsh-session-format-catalog",
  "description": "Build-static first-party Session format codec and migration catalog",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/session/session-format-catalog"
  },
  "type": "module",
  "main": "lib/index.js",
