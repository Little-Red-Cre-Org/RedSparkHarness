    "@redspark/rsh-session-format-v2-to-v3": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/rsh-session": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-session": "workspace:^"
  }
