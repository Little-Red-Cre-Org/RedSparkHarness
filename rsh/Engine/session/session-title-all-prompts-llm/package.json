{
  "name": "@redspark/rsh-session-title-all-prompts-llm",
  "description": "All-user-messages LLM provider plugin for RedSpark Harness session titles",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/session/session-title-all-prompts-llm"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-title": "workspace:^",
    "@redspark/rsh-session-title-llm": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "dependencies": {
    "@redspark/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-title": "workspace:^",
    "@redspark/rsh-session-title-llm": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-llm": {
      "optional": true
    },
    "@redspark/rsh-session": {
      "optional": true
    },
    "@redspark/rsh-session-title": {
      "optional": true
    },
    "@redspark/rsh-native-runtime": {
      "optional": true
    }
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "sessionTitles",
        "model"
      ],
      "optional": [],
      "provides": []
    }
  }
}
