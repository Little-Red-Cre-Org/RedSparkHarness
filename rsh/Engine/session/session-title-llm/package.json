{
  "name": "@redspark/rsh-session-title-llm",
  "description": "Shared LLM generation policy for RedSpark Harness session-title providers",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/session/session-title-llm"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-title": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-model-execution": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-title": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-model-execution": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-native-runtime": {
      "optional": true
    },
    "@redspark/rsh-native-model-execution": {
      "optional": true
    }
  }
}
