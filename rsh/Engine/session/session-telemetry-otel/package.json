{
  "name": "@redspark/rsh-session-telemetry-otel",
  "description": "OpenTelemetry backend for the RedSpark Harness telemetry seam: hands captured session records to the OTel JS SDK's log pipeline",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/session/session-telemetry-otel"
  },
  "type": "module",
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": ["host"],
      "requires": ["launchEnvironment"],
      "optional": [],
      "provides": ["sessionTelemetry"]
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/otlp-exporter-base": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-telemetry": "workspace:^",
    "@redspark/rsh-anonymous-user-id": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-launch-environment": "workspace:^"
  },
  "peerDependenciesMeta": { "@redspark/cordis": { "optional": true } },
  "scripts": { "bundle": "tsdown" },
  "devDependencies": {
    "@redspark/cordis-plugin-logger-console": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-app-boot": "workspace:^",
    "@redspark/rsh-bash-local": "workspace:^",
    "@redspark/rsh-command-feedback": "workspace:^",
    "@redspark/rsh-message-feedback": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-loader-smoke": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-checkpoint-policy": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-session-telemetry": "workspace:^",
    "@redspark/rsh-subprocess-local": "workspace:^",
    "@redspark/rsh-anonymous-user-id": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-http-proxy": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-launch-environment": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^"
  }
}
