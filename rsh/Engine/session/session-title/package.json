{
  "name": "@redspark/rsh-session-title",
  "description": "Log-backed session title service and provider registry for the RedSpark Harness",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/session/session-title"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./normalize": {
      "types": "./lib/types/normalize.d.ts",
      "default": "./lib/types/normalize.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-agent": {
      "optional": true
    },
    "@redspark/rsh-invariants": {
      "optional": true
    },
    "@redspark/rsh-llm": {
      "optional": true
    },
    "@redspark/rsh-session-projection": {
      "optional": true
    },
    "@redspark/rsh-native-runtime": {
      "optional": true
    },
    "@redspark/rsh-native-agent": {
      "optional": true
    },
    "@redspark/rsh-native-session-execution": {
      "optional": true
    }
  },
  "dependencies": {
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/rsh-native-headless": "workspace:^",
    "@redspark/rsh-native-model-execution": "workspace:^",
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "activeSessions"
      ],
      "optional": [],
      "provides": [
        "sessionTitles"
      ]
    }
  }
}
