{
  "name": "@redspark/rsh-request-context-definition",
  "description": "Cordis-free Definition for durable Native request context",
  "version": "1.0.0",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git", "directory": "rsh/Engine/context/request-context-definition" },
  "type": "module",
  "dsh": { "runtime": { "apiVersion": 1, "role": "definition", "capability": "requestContexts" } },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": { ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" }, "./package.json": "./package.json" },
  "files": ["lib/index.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/rsh-session": "workspace:^"
  }
}