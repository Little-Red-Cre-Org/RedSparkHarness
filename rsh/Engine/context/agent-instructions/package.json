{
  "name": "@redspark/rsh-agent-instructions",
  "description": "Workspace context loader for AGENTS.md/CLAUDE.md instruction files",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/context/agent-instructions"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-home-paths": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-reference": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-agent-loop-testkit": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-home-paths": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-llm-deepseek": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-reference": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tool-fs": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "fs"
      ],
      "optional": [
        "tools",
        "sessionReference"
      ],
      "provides": [
        "agentInstructions"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-agent": {
      "optional": true
    },
    "@redspark/rsh-session-projection": {
      "optional": true
    },
    "@redspark/rsh-session-reference": {
      "optional": true
    },
    "@redspark/rsh-tools": {
      "optional": true
    },
    "@redspark/rsh-native-tools": {
      "optional": true
    }
  }
}
