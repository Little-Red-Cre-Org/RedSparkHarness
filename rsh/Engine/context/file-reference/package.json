{
  "name": "@deepseek-ai/dsh-file-reference",
  "description": "File-reference discovery contract and shared @file grammar",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "rsh/Engine/context/file-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./grammar": {
      "types": "./lib/types/grammar.d.ts",
      "default": "./lib/types/grammar.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/types/native.js"
    },
    "./prompt": {
      "types": "./lib/types/prompt.d.ts",
      "default": "./lib/types/prompt.js"
    },
    "./search": {
      "types": "./lib/types/search-core.d.ts",
      "default": "./lib/types/search-core.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-native-agent": "workspace:^",
    "@deepseek-ai/dsh-native-runtime": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-native-agent": "workspace:^",
    "@deepseek-ai/dsh-native-runtime": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-native-agent": { "optional": true },
    "@deepseek-ai/dsh-native-runtime": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true }
  }
}
