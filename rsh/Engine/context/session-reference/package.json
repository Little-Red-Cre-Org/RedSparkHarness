{
  "name": "@redspark/rsh-session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-compaction": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-output-retention": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-session-projection-cache": "workspace:^",
    "@redspark/rsh-session-query": "workspace:^",
    "@redspark/rsh-session-title": "workspace:^",
    "@redspark/rsh-spill": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-agent": {
      "optional": true
    },
    "@redspark/rsh-system-prompt": {
      "optional": true
    },
    "@redspark/rsh-typert-protocol": {
      "optional": true
    },
    "@redspark/rsh-spill": {
      "optional": true
    },
    "@redspark/rsh-session-projection-cache": {
      "optional": true
    },
    "@redspark/rsh-native-runtime": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/cordis-plugin-include": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-compaction": "workspace:^",
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-output-retention": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-session-projection-cache": "workspace:^",
    "@redspark/rsh-session-query": "workspace:^",
    "@redspark/rsh-session-query-sqlite": "workspace:^",
    "@redspark/rsh-session-title": "workspace:^",
    "@redspark/rsh-spill": "workspace:^",
    "@redspark/rsh-spill-local": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tool-fs": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "sessionQuery"
      ],
      "optional": [
        "spillStore"
      ],
      "provides": [
        "sessionReference"
      ]
    }
  }
}
