{
  "name": "@deepseek-ai/dsh-subagent-protocol",
  "description": "Pure durable Subagent descriptor and assistant output values",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "rsh/Engine/subagent/subagent-protocol"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./descriptor": {
      "types": "./lib/types/descriptor.d.ts",
      "default": "./lib/descriptor.js"
    },
    "./assistant-output": {
      "types": "./lib/types/assistant-output.d.ts",
      "default": "./lib/assistant-output.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-util-values": "workspace:^"
  }
}
