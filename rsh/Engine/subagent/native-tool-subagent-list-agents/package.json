{
  "name": "@deepseek-ai/dsh-native-tool-subagent-list-agents",
  "description": "Read-only native continuable subagent directory",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "rsh/Engine/subagent/native-tool-subagent-list-agents"
  },
  "type": "module",
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "tools",
        "subagents"
      ],
      "optional": [],
      "provides": []
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-native-runtime": "workspace:^",
    "@deepseek-ai/dsh-native-tools": "workspace:^",
    "@deepseek-ai/dsh-native-subagent": "workspace:^"
  }
}
