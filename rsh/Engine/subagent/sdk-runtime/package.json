{
  "name": "@redspark/rsh-sdk-runtime",
  "description": "Cordis-free RedSpark Harness SDK protocol runtime and Session API",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/subagent/sdk-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-sdk-protocol": "workspace:^",
    "@redspark/rsh-subprocess-local": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-subagent": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-subagent": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^"
  }
}
