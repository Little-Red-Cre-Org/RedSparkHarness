{
  "name": "@redspark/rsh-subagent",
  "description": "Abstract subagent seam (ctx.subagents): named-provider registry for delegating to child agents",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/subagent/subagent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./internal": {
      "types": "./lib/types/internal.d.ts",
      "default": "./lib/types/internal.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-chunked-list": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^",
    "zod": "^4.4.3",
    "@redspark/rsh-subagent-protocol": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-presets": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-jobs": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-session-projection-cache": "workspace:^",
    "@redspark/rsh-session-query": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^",
    "@redspark/rsh-approval-definition": "workspace:^",
    "@redspark/rsh-util-time": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/rsh-agent-presets": {
      "optional": true
    },
    "@redspark/rsh-sandbox": {
      "optional": true
    },
    "@redspark/rsh-sandbox-policy": {
      "optional": true
    },
    "@redspark/rsh-session-persistence": {
      "optional": true
    },
    "@redspark/rsh-session-projection": {
      "optional": true
    },
    "@redspark/rsh-session-projection-cache": {
      "optional": true
    },
    "@redspark/rsh-session-query": {
      "optional": true
    },
    "@redspark/rsh-jobs": {
      "optional": true
    },
    "@redspark/rsh-approval-definition": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-presets": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-user-approval": "workspace:^",
    "@redspark/rsh-jobs": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-schedule": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
