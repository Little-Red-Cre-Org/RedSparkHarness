{
  "name": "@redspark/rsh-tool-ralph",
  "description": "Model-facing fresh-agent Ralph loop over the workflow and subagent seams",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Engine/workflow/tool-ralph"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./runtime": {
      "types": "./lib/types/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/runtime.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-subagent": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-native-prompt": "workspace:^",
    "@redspark/rsh-native-subagent": "workspace:^",
    "@redspark/rsh-workflow": "workspace:^",
    "@redspark/rsh-tool-workflow": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-agent-loop-testkit": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-subagent": "workspace:^",
    "@redspark/rsh-subagent-in-process-driver": "workspace:^",
    "@redspark/rsh-subagent-spawn-in-process": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-workflow": "workspace:^",
    "@redspark/rsh-workflow-worker-thread": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/rsh-agent": { "optional": true },
    "@redspark/rsh-llm": { "optional": true },
    "@redspark/rsh-subagent": { "optional": true },
    "@redspark/rsh-system-prompt": { "optional": true },
    "@redspark/rsh-tools": { "optional": true },
    "@redspark/cordis": { "optional": true }
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": ["host"],
      "requires": ["tools", "workflow", "subagents", "promptSections"],
      "optional": [],
      "provides": []
    }
  }
}
