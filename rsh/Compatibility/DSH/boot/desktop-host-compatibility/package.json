{
  "name": "@deepseek-ai/dsh-desktop-host-compatibility",
  "description": "Explicit Cordis Desktop Host assembly for profiles that select legacy bundles",
  "version": "0.1.5-rc.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Compatibility/DSH/boot/desktop-host-compatibility"
  },
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib/index.js",
    "config/desktop.cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -b && tsdown"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-web-compatibility": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-api-gateway": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@deepseek-ai/dsh-client-modules": "workspace:^",
    "@deepseek-ai/dsh-http-routes": "workspace:^",
    "@deepseek-ai/dsh-http-routes-cordis": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-api-gateway": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@deepseek-ai/dsh-client-modules": "workspace:^",
    "@deepseek-ai/dsh-http-routes": "workspace:^",
    "@deepseek-ai/dsh-http-routes-cordis": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  }
}
