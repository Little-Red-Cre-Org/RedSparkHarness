{
  "name": "@redspark/rsh-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Compatibility/DSH/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@redspark/cordis-plugin-timer": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-deepseek-llm-api-extensions": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-jobs-local": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-llm-deepseek": "workspace:^",
    "@redspark/rsh-llm-retry": "workspace:^",
    "@redspark/rsh-plugin-package-inventory-deepseek": "workspace:^",
    "@redspark/rsh-sandbox-local": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-sdk-app": "workspace:^",
    "@redspark/rsh-sdk-jsonrpc-server": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-log-deepseek": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-session-title": "workspace:^",
    "@redspark/rsh-subprocess-local": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-terminal": "workspace:^",
    "@redspark/rsh-terminal-bash": "workspace:^",
    "@redspark/rsh-tool-bash-persistent": "workspace:^",
    "@redspark/rsh-tool-pwsh-persistent": "workspace:^",
    "@redspark/rsh-tools": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/cordis-plugin-include": "workspace:^"
  }
}
