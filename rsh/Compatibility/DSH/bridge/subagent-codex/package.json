{
  "name": "@redspark/rsh-subagent-codex",
  "description": "One-shot Codex subagent provider over the official app-server protocol",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Compatibility/DSH/bridge/subagent-codex"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-subagent": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-codex-app-server": "workspace:^",
    "@redspark/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-app-boot": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-loader-smoke": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-checkpoint-policy": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-subagent": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^",
    "@redspark/rsh-subprocess-local": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/rsh-tool-jobs": "workspace:^",
    "@redspark/rsh-tool-subagent": "workspace:^",
    "@redspark/rsh-tools": "workspace:^"
  }
}
