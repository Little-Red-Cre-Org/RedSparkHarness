{
  "name": "@redspark/rsh-compat-fs-sandbox",
  "description": "Selected legacy sandbox filesystem Provider for native profiles",
  "version": "1.0.0",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git", "directory": "rsh/Compatibility/DSH/bridge/compat-fs-sandbox" },
  "type": "module",
  "dsh": { "native": { "apiVersion": 1, "entry": "./native", "targets": ["host"], "requires": ["sandboxPolicy", "compatDshRuntime"], "optional": [], "provides": ["fs"] } },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./native": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": { "@redspark/cordis": "workspace:^" },
  "devDependencies": { "@redspark/cordis": "workspace:^" },
  "dependencies": {
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-compat-dsh-runtime": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-fs-sandbox": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-native-sandbox-policy": "workspace:^"
  }
}
