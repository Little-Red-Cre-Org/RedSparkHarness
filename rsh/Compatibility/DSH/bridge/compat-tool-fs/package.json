{
  "name": "@redspark/rsh-compat-tool-fs",
  "description": "Legacy filesystem tools as native tool and prompt contributions",
  "version": "1.0.0",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git", "directory": "rsh/Compatibility/DSH/bridge/compat-tool-fs" },
  "type": "module",
  "dsh": { "native": { "apiVersion": 1, "entry": "./native", "targets": ["host"], "requires": ["fs", "tools", "promptSections", "compatDshRuntime"], "optional": ["sandboxPolicy", "fsObservationPolicy", "approval"], "provides": ["compatToolFs"] } },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./native": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-approval": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/rsh-native-approval": { "optional": true }
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-approval-definition": "workspace:^",
    "@redspark/rsh-compat-fs-policy": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-fs-observation-policy": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-native-headless": "workspace:^",
    "@redspark/rsh-native-approval": "workspace:^",
    "@redspark/rsh-native-model-execution": "workspace:^",
    "@redspark/rsh-compat-fs-sandbox": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-compat-dsh-runtime": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-native-prompt": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-tool-fs": "workspace:^",
    "@redspark/rsh-native-sandbox-policy": "workspace:^"
  }
}
