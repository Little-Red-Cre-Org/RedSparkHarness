{
  "name": "@redspark/rsh-native-tui",
  "version": "1.0.0",
  "description": "Native interactive Ink terminal application",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/TUI/native-tui"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-headless": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-terminal-ui": "workspace:^",
    "ink": "^5.2.1",
    "react": "^18.2.0",
    "ink-text-input": "^6.0.0",
    "@redspark/rsh-native-model-execution": "workspace:^",
    "@redspark/rsh-native-model-selection": "workspace:^",
    "zod": "^4.3.6",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-native-approval": "workspace:^",
    "@redspark/rsh-approval-definition": "workspace:^",
    "@redspark/rsh-user-questions": "workspace:^",
    "@redspark/rsh-agent-presets": "workspace:^",
    "@redspark/rsh-commands": "workspace:^",
    "@redspark/rsh-skill": "workspace:^",
    "@redspark/rsh-brand": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@types/react": "^18.2.0",
    "node-pty": "1.2.0-beta.15"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "fs",
        "sessionPersistence",
        "modelExecution",
        "agents",
        "sessionExecution",
        "activeSessions"
      ],
      "optional": [
        "tools",
        "promptSections",
        "sandboxPolicy",
        "approval",
        "codeRuntime",
        "timeContext",
        "tmuxContext",
        "agentPresets",
        "commands",
        "skillInvocations",
        "workspaceRegistry",
        "agentInstructions",
        "modelSelection",
        "modelDirectory",
        "userQuestions",
        "attachments",
        "requestContexts",
        "sessionReference"
      ],
      "provides": [
        "application",
        "rootExecution"
      ]
    }
  },
  "scripts": {
    "bundle": "tsdown"
  }
}
