{
  "name": "@redspark/rsh-desktop-host",
  "description": "Private upstream-Node host process for the Electron desktop application",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@redspark/rsh": "workspace:^",
    "@redspark/rsh-client-connection": "workspace:^",
    "@redspark/rsh-native-web-assets": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-web-session-controller": "workspace:^"
  },
  "optionalDependencies": {
    "@redspark/rsh-desktop-host-compatibility": "workspace:^"
  },
  "exports": {
    "./native-host": {
      "types": "./lib/types/native-host.d.ts",
      "default": "./lib/native-host.js"
    },
    "./package.json": "./package.json"
  }
}
