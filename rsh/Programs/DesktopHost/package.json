{
  "name": "@deepseek-ai/dsh-desktop-host",
  "description": "Private upstream-Node host process for the Electron desktop application",
  "version": "0.1.5-rc.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/*.js",
    "config/desktop.cordis.patch.yml",
    "lib/types/**/*.d.ts"
