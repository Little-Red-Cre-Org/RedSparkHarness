  "dependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/dsh": "workspace:^",
    "@deepseek-ai/dsh-api-gateway": "workspace:^",
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-client-connection": "workspace:^",
    "@deepseek-ai/dsh-client-modules": "workspace:^",
    "@deepseek-ai/dsh-client-native-application": "workspace:^",
    "@deepseek-ai/dsh-client-native-session": "workspace:^",
    "@deepseek-ai/dsh-client-ui-directory-picker-native": "workspace:^",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-credentials-local": "workspace:^",
    "@deepseek-ai/dsh-fs-local": "workspace:^",
    "@deepseek-ai/dsh-host-directory-picker-native": "workspace:^",
    "@deepseek-ai/dsh-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-launch-environment": "workspace:^",
    "@deepseek-ai/dsh-native-agent": "workspace:^",
    "@deepseek-ai/dsh-native-model-execution": "workspace:^",
    "@deepseek-ai/dsh-native-runtime": "workspace:^",
    "@deepseek-ai/dsh-native-session-execution": "workspace:^",
    "@deepseek-ai/dsh-native-web-assets": "workspace:^",
    "@deepseek-ai/dsh-native-web-session-controller": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:^",
    "@deepseek-ai/dsh-web-frontend": "workspace:^",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-web": "workspace:^"
  },
  "exports": {
    "./native-host": {
      "types": "./lib/types/native-host.d.ts",
      "default": "./lib/native-host.js"
    },
    "./package.json": "./package.json"
