{
  "formatVersion": 1,
  "scopes": [{ "id": "root" }],
  "installations": [
    { "id": "app", "plugin": "@deepseek-ai/dsh-native-headless", "scope": "root", "config": { "cwd": "PROFILE_PATCH_REQUIRED", "provider": "mock", "model": "fixture", "systemPrompt": "Use the filesystem tool.", "maxSteps": 3 } },
    { "id": "agents", "plugin": "@deepseek-ai/dsh-native-agent", "scope": "root" },
    { "id": "jobs", "plugin": "@deepseek-ai/dsh-native-jobs", "scope": "root" },
    { "id": "tools", "plugin": "@deepseek-ai/dsh-native-tools", "scope": "root" },
    { "id": "tool-jobs", "plugin": "@deepseek-ai/dsh-native-tool-jobs", "scope": "root" },
    { "id": "model-execution", "plugin": "@deepseek-ai/dsh-native-model-execution", "scope": "root" },
    { "id": "code-runtime", "plugin": "@deepseek-ai/dsh-native-code-runtime", "scope": "root" },
    { "id": "time-context", "plugin": "@deepseek-ai/dsh-native-time-context", "scope": "root", "config": { "timeZone": "UTC" } },
    { "id": "storage", "plugin": "@deepseek-ai/dsh-session-persistence-jsonl", "scope": "root", "config": { "root": "PROFILE_PATCH_REQUIRED", "compression": "none" } },
    { "id": "fs", "plugin": "@deepseek-ai/dsh-fs-local", "scope": "root", "config": { "cwd": "PROFILE_PATCH_REQUIRED" } },
    { "id": "policy", "plugin": "@deepseek-ai/dsh-fs-observation-policy", "scope": "root" },
    { "id": "model", "plugin": "native-fixture-model", "scope": "root" }
  ]
}
