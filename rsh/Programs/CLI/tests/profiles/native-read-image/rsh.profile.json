{
  "formatVersion": 1,
  "scopes": [
    {
      "id": "root"
    }
  ],
  "installations": [
    {
      "id": "app",
      "plugin": "@redspark/rsh-native-headless",
      "scope": "root",
      "config": {
        "cwd": "PROFILE_PATCH_REQUIRED",
        "provider": "native-image-fixture",
        "model": "vision-fixture",
        "systemPrompt": "Read the requested image using read_image.",
        "maxSteps": 3,
        "builtinTools": false
      }
    },
    {
      "id": "agents",
      "plugin": "@redspark/rsh-native-agent",
      "scope": "root"
    },
    {
      "id": "tools",
      "plugin": "@redspark/rsh-native-tools",
      "scope": "root",
      "config": {
        "mode": "native"
      }
    },
    {
      "id": "model-execution",
      "plugin": "@redspark/rsh-native-model-execution",
      "scope": "root"
    },
    {
      "id": "prompt",
      "plugin": "@redspark/rsh-native-prompt",
      "scope": "root"
    },
    {
      "id": "credentials",
      "plugin": "@redspark/rsh-credentials-local",
      "scope": "root",
      "config": {
        "watch": false
      }
    },
    {
      "id": "storage",
      "plugin": "@redspark/rsh-session-persistence-jsonl",
      "scope": "root",
      "config": {
        "root": "PROFILE_PATCH_REQUIRED",
        "compression": "none"
      }
    },
    {
      "id": "fs",
      "plugin": "@redspark/rsh-fs-local",
      "scope": "root",
      "config": {
        "cwd": "PROFILE_PATCH_REQUIRED"
      }
    },
    {
      "id": "policy",
      "plugin": "@redspark/rsh-fs-observation-policy",
      "scope": "root"
    },
    {
      "id": "attachments",
      "plugin": "@redspark/rsh-attachment-local",
      "scope": "root"
    },
    {
      "id": "file-tools",
      "plugin": "@redspark/rsh-tool-fs",
      "scope": "root"
    },
    {
      "id": "model",
      "plugin": "@redspark/rsh-llm-pi-ai",
      "scope": "root",
      "config": {
        "providers": {
          "native-image-fixture": {
            "apiKeyEnv": "NATIVE_IMAGE_KEY",
            "api": "openai-completions",
            "baseURL": "PROFILE_PATCH_REQUIRED",
            "models": [
              {
                "id": "vision-fixture",
                "name": "Fixture vision",
                "input": [
                  "text",
                  "image"
                ],
                "contextWindow": 4096,
                "maxTokens": 512
              }
            ]
          }
        }
      }
    }
  ]
}
