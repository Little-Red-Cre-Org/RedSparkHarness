{
  "formatVersion": 1,
  "scopes": [
    {
      "id": "root"
    }
  ],
  "installations": [
    {
      "id": "app",
      "plugin": "@redspark/rsh-native-headless",
      "scope": "root",
      "config": {
        "cwd": "PROFILE_PATCH_REQUIRED",
        "provider": "mock",
        "model": "fixture",
        "systemPrompt": "Use run_code to inspect and cancel the background job.",
        "maxSteps": 3,
        "builtinTools": false
      }
    },
    {
      "id": "agents",
      "plugin": "@redspark/rsh-native-agent",
      "scope": "root"
    },
    {
      "id": "jobs",
      "plugin": "@redspark/rsh-native-jobs",
      "scope": "root"
    },
    {
      "id": "tools",
      "plugin": "@redspark/rsh-native-tools",
      "scope": "root",
      "config": {
        "mode": "ptc"
      }
    },
    {
      "id": "tool-jobs",
      "plugin": "@redspark/rsh-native-tool-jobs",
      "scope": "root"
    },
    {
      "id": "model-execution",
      "plugin": "@redspark/rsh-native-model-execution",
      "scope": "root"
    },
    {
      "id": "prompt",
      "plugin": "@redspark/rsh-native-prompt",
      "scope": "root"
    },
    {
      "id": "code-tool",
      "plugin": "@redspark/rsh-tool-code-runtime",
      "scope": "root",
      "config": {
        "maxParallelSubCalls": 2,
        "sdkPrompt": true
      }
    },
    {
      "id": "code-runtime",
      "plugin": "@redspark/rsh-code-runtime-process-sandbox",
      "scope": "root",
      "config": {
        "computeMs": 2000,
        "maxWallMs": 10000,
        "maxOutputBytes": 1048576,
        "maxOldGenerationSizeMb": 128
      }
    },
    {
      "id": "subprocess",
      "plugin": "@redspark/rsh-subprocess-local",
      "scope": "root"
    },
    {
      "id": "sandbox",
      "plugin": "@redspark/rsh-sandbox-local",
      "scope": "root"
    },
    {
      "id": "sandbox-policy",
      "plugin": "@redspark/rsh-native-sandbox-policy",
      "scope": "root",
      "config": {
        "mode": "read-only",
        "workspaceRoot": "PROFILE_PATCH_REQUIRED"
      }
    },
    {
      "id": "storage",
      "plugin": "@redspark/rsh-session-persistence-jsonl",
      "scope": "root",
      "config": {
        "root": "PROFILE_PATCH_REQUIRED",
        "compression": "none"
      }
    },
    {
      "id": "fs",
      "plugin": "@redspark/rsh-fs-local",
      "scope": "root",
      "config": {
        "cwd": "PROFILE_PATCH_REQUIRED"
      }
    },
    {
      "id": "policy",
      "plugin": "@redspark/rsh-fs-observation-policy",
      "scope": "root"
    },
    {
      "id": "model",
      "plugin": "native-ptc-model",
      "scope": "root"
    },
    {
      "id": "shell",
      "plugin": "@redspark/rsh-bash-local",
      "scope": "root",
      "config": {
        "graceMs": 500
      }
    },
    {
      "id": "shell-env",
      "plugin": "@redspark/rsh-shell-env",
      "scope": "root"
    },
    {
      "id": "tool-bash",
      "plugin": "@redspark/rsh-tool-bash",
      "scope": "root"
    }
  ]
}
