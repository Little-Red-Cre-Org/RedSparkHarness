{
  "name": "@redspark/rsh-api-settings-controller",
  "description": "Remote owner for settings, credentials, and human-guided authorization surfaces",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/api/settings-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@redspark/rsh-settings-definition": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent-presets": "workspace:^",
    "@redspark/rsh-authorization": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-native-command": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-settings": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent-presets": "workspace:^",
    "@redspark/rsh-authorization": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-native-command": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-settings": "workspace:^",
    "@redspark/rsh-settings-definition": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^"
  }
}
