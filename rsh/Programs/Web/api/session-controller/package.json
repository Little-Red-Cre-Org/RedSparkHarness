{
  "name": "@redspark/rsh-api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client-event-types": {
      "types": "./lib/types/client-event-types.d.ts"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "external": [
        "@redspark/rsh-api-gateway/client"
      ],
      "inject": [
        "@redspark/rsh-api-gateway",
        "@redspark/rsh-client-file-upload"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-deque": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "mime-types": "^3.0.2",
    "zod": "^4.4.3",
    "@redspark/rsh-native-model-execution": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-default-model": "workspace:^",
    "@redspark/rsh-agent-presets": "workspace:^",
    "@redspark/rsh-api-gateway": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-client-connection": "workspace:^",
    "@redspark/rsh-client-file-upload": "workspace:^",
    "@redspark/rsh-commands": "workspace:^",
    "@redspark/rsh-file-reference": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-jobs": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-command": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-session-projection-cache": "workspace:^",
    "@redspark/rsh-session-query": "workspace:^",
    "@redspark/rsh-session-title": "workspace:^",
    "@redspark/rsh-skill": "workspace:^",
    "@redspark/rsh-subagent": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^",
    "@redspark/rsh-typert-registry": "workspace:^",
    "@redspark/rsh-util-time": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/rsh-util-workspace-path": "workspace:^",
    "@redspark/rsh-workspace": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-jobs": {
      "optional": true
    },
    "@redspark/rsh-session-persistence": {
      "optional": true
    },
    "@redspark/rsh-session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-default-model": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-agent-loop-testkit": "workspace:^",
    "@redspark/rsh-agent-presets": "workspace:^",
    "@redspark/rsh-api-gateway": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-client-connection": "workspace:^",
    "@redspark/rsh-client-file-upload": "workspace:^",
    "@redspark/rsh-client-store": "workspace:^",
    "@redspark/rsh-client-test-runtime": "workspace:^",
    "@redspark/rsh-commands": "workspace:^",
    "@redspark/rsh-file-reference": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-jobs": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-command": "workspace:^",
    "@redspark/rsh-permission-presets": "workspace:^",
    "@redspark/rsh-remote-mock": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-session-projection-cache": "workspace:^",
    "@redspark/rsh-session-query": "workspace:^",
    "@redspark/rsh-session-title": "workspace:^",
    "@redspark/rsh-skill": "workspace:^",
    "@redspark/rsh-storage": "workspace:^",
    "@redspark/rsh-storage-domain": "workspace:^",
    "@redspark/rsh-storage-json": "workspace:^",
    "@redspark/rsh-subagent": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^",
    "@redspark/rsh-typert-registry": "workspace:^",
    "@redspark/rsh-util-crypto": "workspace:^",
    "@redspark/rsh-util-time": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/rsh-util-workspace-path": "workspace:^",
    "@redspark/rsh-workspace": "workspace:^",
    "@types/mime-types": "^3.0.1"
  }
}
