{
  "name": "@redspark/rsh-native-web-session-controller",
  "description": "Native Web Session host lifecycle",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/api/native-web-session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "hostConnection",
        "fs",
        "sessionPersistence",
        "modelExecution",
        "agents",
        "sessionExecution",
        "activeSessions",
        "workspaceRegistry"
      ],
      "optional": [
        "tools",
        "promptSections",
        "sandboxPolicy",
        "approval",
        "codeRuntime",
        "timeContext",
        "tmuxContext",
        "modelSelection",
        "modelDirectory",
        "modelSettings",
        "agentPresets",
        "planMode",
        "permissionPresets",
        "agentInstructions",
        "userQuestions",
        "attachments",
        "settings",
        "credentials",
        "authorization",
        "accounts",
        "sessionTitles",
        "commands",
        "pluginInventory",
        "requestContexts",
        "sessionFeedback",
        "messageFeedback", "fileReferences"
      ],
      "provides": [
        "nativeWebSession",
        "rootExecution"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-client-connection": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-headless": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-title": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-llm-pi-ai": "workspace:^",
    "@redspark/rsh-native-model-execution": "workspace:^",
    "@redspark/rsh-settings-definition": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.4.3",
    "@redspark/rsh-native-model-selection": "workspace:^",
    "@redspark/rsh-agent-presets": "workspace:^",
    "@redspark/rsh-plan-mode": "workspace:^",
    "@redspark/rsh-permission-presets": "workspace:^",
    "@redspark/rsh-settings": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-authorization": "workspace:^",
    "@redspark/rsh-native-approval": "workspace:^",
    "@redspark/rsh-approval-definition": "workspace:^",
    "@redspark/rsh-user-questions": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-commands": "workspace:^",
    "@redspark/rsh-native-command": "workspace:^",
    "@redspark/rsh-api-workspace-files": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-workspace": "workspace:^",
    "@redspark/rsh-workspace-definition": "workspace:^",
    "@redspark/rsh-host-directory-picker-native": "workspace:^",
    "@redspark/rsh-command-feedback": "workspace:^",
    "@redspark/rsh-message-feedback": "workspace:^"
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "devDependencies": {
    "@redspark/rsh-settings-definition": "workspace:^",
    "@redspark/rsh-native-web-assets": "workspace:^",
    "@redspark/rsh-client-native-session": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-settings": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-client-native-application": "workspace:^",
    "@redspark/rsh-attachment-local": "workspace:^",
    "@redspark/rsh-native-sandbox-policy": "workspace:^",
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-storage": "workspace:^",
    "@redspark/rsh-storage-domain": "workspace:^",
    "@redspark/rsh-storage-json": "workspace:^",
    "@redspark/rsh-webhook": "workspace:^",
    "@redspark/rsh-webhook-github": "workspace:^"
  }
}
