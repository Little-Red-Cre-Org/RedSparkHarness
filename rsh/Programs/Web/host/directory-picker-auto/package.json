{
  "name": "@redspark/rsh-host-directory-picker-auto",
  "description": "Adaptive chooser of the directory-picker seam: resolves the host situation at boot and mounts the native or browse backend for the RedSpark Harness web GUI host",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/host/directory-picker-auto"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-client-ui-directory-picker-browse": "workspace:^",
    "@redspark/rsh-client-ui-directory-picker-native": "workspace:^",
    "@redspark/rsh-host-directory-picker-browse": "workspace:^",
    "@redspark/rsh-host-directory-picker-native": "workspace:^",
    "@redspark/rsh-http-routes": "workspace:^",
    "@redspark/rsh-http-routes-cordis": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/cordis-plugin-include": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-client-ui-directory-picker-browse": "workspace:^",
    "@redspark/rsh-client-ui-directory-picker-native": "workspace:^",
    "@redspark/rsh-host-directory-picker": "workspace:^",
    "@redspark/rsh-host-directory-picker-browse": "workspace:^",
    "@redspark/rsh-host-directory-picker-native": "workspace:^",
    "@redspark/rsh-host-webserver": "workspace:^",
    "@redspark/rsh-http-routes": "workspace:^",
    "@redspark/rsh-http-routes-cordis": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-launch-environment": "workspace:^"
  }
}
