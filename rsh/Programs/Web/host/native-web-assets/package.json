{
  "name": "@deepseek-ai/dsh-native-web-assets",
  "description": "Cordis-free native Desktop page and built frontend asset routes",
  "version": "0.1.5-rc.2",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "rsh/Programs/Web/host/native-web-assets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./native-client": { "types": "./lib/types/native-client.d.ts", "default": "./lib/native-client.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/native-client.js", "lib/shared-*.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-client-web": "workspace:^",
    "@deepseek-ai/dsh-native-runtime": "workspace:^",
    "esbuild": "^0.28.1"
  }
}
