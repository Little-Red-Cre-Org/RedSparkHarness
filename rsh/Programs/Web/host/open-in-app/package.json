{
  "name": "@redspark/rsh-host-open-in-app",
  "description": "Host half of open-in-app: resolved application catalog, icons, and the launch endpoint as three routes over the composition's route carrier",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/host/open-in-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./shared": {
      "types": "./lib/types/shared.d.ts",
      "default": "./lib/types/shared.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-launch-environment": "workspace:^",
    "@redspark/rsh-native-command": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^",
    "@redspark/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-http-routes": "workspace:^",
    "@redspark/rsh-http-routes-cordis": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-client-connection": "workspace:^",
    "@redspark/rsh-host-webserver": "workspace:^",
    "@redspark/rsh-http-routes": "workspace:^",
    "@redspark/rsh-http-routes-cordis": "workspace:^",
    "@redspark/rsh-launch-environment": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "hostConnection",
        "subprocess",
        "launchEnvironment"
      ],
      "optional": [
        "httpRoutes"
      ],
      "provides": []
    }
  }
}
