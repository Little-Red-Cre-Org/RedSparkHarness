{
  "name": "@redspark/rsh-host-directory-picker-native",
  "description": "Native-OS-chooser backend of the directory-picker seam for the RedSpark Harness web GUI host",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/host/directory-picker-native"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./worker": {
      "types": "./lib/types/win32-dialog-worker.d.ts",
      "default": "./lib/worker.cjs"
    },
    "./native-picker": {
      "types": "./lib/types/native-picker.d.ts",
      "default": "./lib/native-picker.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/worker.cjs",
    "lib/native-picker.js",
    "lib/native-picker-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-host-directory-picker": "workspace:^",
    "@redspark/rsh-native-command": "workspace:^",
    "koffi": "3.1.1"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "tsx": "^4.19.2"
  }
}
