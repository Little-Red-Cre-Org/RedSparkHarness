{
  "name": "@redspark/rsh-client-native-session",
  "description": "Native Web Session client lifecycle",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/native-session"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./list-types": {
      "types": "./lib/types/list-types.d.ts",
      "default": "./lib/list-types.js"
    },
    "./jobs-types": {
      "types": "./lib/types/jobs-types.d.ts",
      "default": "./lib/jobs-types.js"
    },
    "./package.json": "./package.json",
    "./follow-types": {
      "types": "./lib/types/follow-types.d.ts",
      "default": "./lib/follow-types.js"
    },
    "./model-controls": {
      "types": "./lib/types/model-controls.d.ts",
      "default": "./lib/model-controls.js"
    },
    "./human": {
      "types": "./lib/types/human.d.ts",
      "default": "./lib/human.js"
    },
    "./schedule-types": {
      "types": "./lib/types/schedule-types.d.ts",
      "default": "./lib/schedule-types.js"
    },
    "./workspaces": {
      "types": "./lib/types/workspaces.d.ts",
      "default": "./lib/workspaces.js"
    }
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "client"
      ],
      "requires": [
        "clientConnection"
      ],
      "optional": [],
      "provides": [
        "clientNativeSession",
        "clientNativeSchedule",
        "clientNativeSessionJobs",
        "clientNativeWorkspace",
        "clientNativeDirectoryPicker",
        "clientNativeWorkspaceFiles",
        "clientNativeFileReferences"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/list-types.js",
    "lib/follow-types.js",
    "lib/model-controls.js",
    "lib/human.js",
    "lib/workspaces.js",
    "lib/schedule-types.js",
    "lib/jobs-types.js",
    "lib/native-*.js",
    "lib/shared-*.js",
    "lib/workspaces-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "eventsource-parser": "^3.1.0",
    "zod": "^4.4.3",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-client-connection": "workspace:^",
    "@redspark/rsh-native-model-selection": "workspace:^",
    "@redspark/rsh-agent-presets": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-commands": "workspace:^",
    "@redspark/rsh-authorization": "workspace:^",
    "@redspark/rsh-api-workspace-files": "workspace:^",
    "@redspark/rsh-command-feedback": "workspace:^",
    "@redspark/rsh-message-feedback": "workspace:^"
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "peerDependencies": {
    "@redspark/rsh-session": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-workspace-definition": "workspace:^"
  }
}
