{
  "name": "@redspark/rsh-client-connection",
  "description": "Authenticated RPC transport, generation lifecycle, and browser fixture",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/connection"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./native-host": {
      "types": "./lib/types/native-host.d.ts",
      "default": "./lib/native-host.js"
    },
    "./http-bridge": {
      "types": "./lib/types/http-bridge.d.ts",
      "default": "./lib/http-bridge.js"
    },
    "./native-http-bridge": {
      "types": "./lib/types/native-http-bridge.d.ts",
      "default": "./lib/native-http-bridge.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    },
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "client"
      ],
      "requires": [],
      "optional": [],
      "provides": [
        "clientConnection"
      ]
    }
  },
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/native.js",
    "lib/native-host.js",
    "lib/http-bridge.js",
    "lib/native-http-bridge.js",
    "lib/host-core-*.js",
    "lib/rpc-*.js",
    "lib/recovery-config-*.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@redspark/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": { "optional": true }
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-api-session-controller": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-commands": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-host-directory-picker": "workspace:^",
    "@redspark/rsh-http-routes": "workspace:^",
    "@redspark/rsh-http-routes-cordis": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-settings": "workspace:^",
    "@redspark/rsh-settings-definition": "workspace:^",
    "@redspark/rsh-tool-todo": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^"
  }
}
