{
  "name": "@redspark/rsh-client-ui-chat",
  "description": "Chat Conversation target, node definitions, renderers, and details surface",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/ui-chat"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@redspark/rsh-api-session-controller",
        "@redspark/rsh-api-workspace-controller",
        "@redspark/rsh-client-locale",
        "@redspark/rsh-client-ui-conversation",
        "@redspark/rsh-client-ui-input-trigger",
        "@redspark/rsh-client-ui-layout",
        "@redspark/rsh-client-ui-renderer",
        "@redspark/rsh-client-ui-session",
        "@redspark/rsh-client-ui-settings",
        "@redspark/rsh-client-ui-sidebar-right",
        "@redspark/rsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-api-remotes": "workspace:^",
    "@redspark/rsh-api-session-controller": "workspace:^",
    "@redspark/rsh-api-workspace-controller": "workspace:^",
    "@redspark/rsh-api-workspace-files": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-client-locale": "workspace:^",
    "@redspark/rsh-client-store": "workspace:^",
    "@redspark/rsh-client-ui-approval": "workspace:^",
    "@redspark/rsh-client-ui-conversation": "workspace:^",
    "@redspark/rsh-client-ui-input-trigger": "workspace:^",
    "@redspark/rsh-client-ui-layout": "workspace:^",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "@redspark/rsh-client-ui-renderer": "workspace:^",
    "@redspark/rsh-client-ui-session": "workspace:^",
    "@redspark/rsh-client-ui-settings": "workspace:^",
    "@redspark/rsh-client-ui-sidebar-documentpreview": "workspace:^",
    "@redspark/rsh-client-ui-sidebar-right": "workspace:^",
    "@redspark/rsh-client-ui-slots": "workspace:^",
    "@redspark/rsh-client-ui-workspace": "workspace:^",
    "@redspark/rsh-commands": "workspace:^",
    "@redspark/rsh-compaction": "workspace:^",
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-llm-retry": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-stats": "workspace:^",
    "@redspark/rsh-session-turn-outline": "workspace:^",
    "@redspark/rsh-settings": "workspace:^",
    "@redspark/rsh-token-meter": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-util-workspace-path": "workspace:^",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "dependencies": {
    "@redspark/schemastery": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
