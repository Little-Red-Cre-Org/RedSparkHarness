{
  "name": "@redspark/rsh-client-ui-deliverables",
  "description": "Produced-files turn tail and clickable final-response file references for Web",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/ui-deliverables"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@redspark/rsh-api-remotes",
        "@redspark/rsh-client-connection",
        "@redspark/rsh-client-locale",
        "@redspark/rsh-client-ui-chat",
        "@redspark/rsh-client-ui-conversation",
        "@redspark/rsh-client-ui-renderer",
        "@redspark/rsh-client-ui-tool"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "@redspark/rsh-util-workspace-path": "workspace:^",
    "@redspark/rsh-client-locale": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-api-remotes": "workspace:^",
    "@redspark/rsh-client-connection": "workspace:^",
    "@redspark/rsh-client-locale": "workspace:^",
    "@redspark/rsh-client-store": "workspace:^",
    "@redspark/rsh-client-test-runtime": "workspace:^",
    "@redspark/rsh-client-ui-chat": "workspace:^",
    "@redspark/rsh-client-ui-conversation": "workspace:^",
    "@redspark/rsh-client-ui-renderer": "workspace:^",
    "@redspark/rsh-client-ui-slots": "workspace:^",
    "@types/react": "~18.3.1",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-session-query": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-client-ui-tool": "workspace:^",
    "@redspark/rsh-tool-present": "workspace:^",
    "@redspark/rsh-api-session-controller": "workspace:^",
    "@redspark/rsh-util-workspace-path": "workspace:^",
    "@redspark/rsh-api-workspace-files": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/native.js",
    "lib/**/*.css",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@redspark/rsh-typert-protocol": "workspace:^",
    "react": "^18.2.0",
    "@redspark/rsh-session": "workspace:^"
  }
}
