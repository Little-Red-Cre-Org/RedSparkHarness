{
  "name": "@redspark/rsh-client-ui-layout",
  "description": "Shell plugin: three-column AppFrame with drag handles, ctx.layout viewing-state service (navigation + panels)",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/ui-layout"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@redspark/rsh-client-locale",
        "@redspark/rsh-client-ui-renderer",
        "@redspark/rsh-client-ui-session",
        "@redspark/rsh-client-ui-theme"
      ],
      "platform": "web"
    },
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "client"
      ],
      "requires": [
        "clientSlots",
        "clientLocale",
        "clientNativeTheme",
        "clientNativeSessionPresentation"
      ],
      "optional": [],
      "provides": [
        "clientNativeLayout"
      ]
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-client-store": "workspace:^",
    "@redspark/rsh-client-ui-slots": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-client-locale": "workspace:^",
    "@redspark/rsh-client-ui-renderer": "workspace:^",
    "@redspark/rsh-client-ui-session": "workspace:^",
    "@redspark/rsh-client-ui-theme": "workspace:^",
    "@types/react": "~18.3.1",
    "@redspark/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/native.js",
    "lib/client/AppFrame.module.css",
    "lib/types/**/*.d.ts"
  ]
}
