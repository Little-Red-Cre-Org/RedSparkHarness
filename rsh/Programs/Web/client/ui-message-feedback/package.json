{
  "name": "@redspark/rsh-client-ui-message-feedback",
  "description": "The Web feedback surface: per-message Like/Dislike in the assistant-message action strip and the feedback dialog behind both ratings and /feedback, backed by the messageFeedback and sessionFeedback Host Remotes",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/ui-message-feedback"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@redspark/rsh-api-remotes",
        "@redspark/rsh-client-locale",
        "@redspark/rsh-client-ui-conversation",
        "@redspark/rsh-client-ui-renderer",
        "@redspark/rsh-client-ui-commands"
      ],
      "platform": "web"
    },
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "client"
      ],
      "requires": [
        "clientSlots",
        "clientLocale",
        "clientNativeSession",
        "clientNativeConversation"
      ],
      "optional": [],
      "provides": []
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-api-remotes": "workspace:^",
    "@redspark/rsh-client-connection": "workspace:^",
    "@redspark/rsh-client-locale": "workspace:^",
    "@redspark/rsh-client-test-runtime": "workspace:^",
    "@redspark/rsh-client-ui-conversation": "workspace:^",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "@redspark/rsh-client-ui-renderer": "workspace:^",
    "@redspark/rsh-client-ui-slots": "workspace:^",
    "@redspark/rsh-message-feedback": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@redspark/rsh-client-ui-chat": "workspace:^",
    "@redspark/rsh-client-ui-session": "workspace:^",
    "@redspark/rsh-client-ui-commands": "workspace:^",
    "@redspark/rsh-command-feedback": "workspace:^",
    "@redspark/rsh-client-store": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-client-native-session": "workspace:^",
    "@redspark/rsh-client-ui-layout": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/native.js",
    "lib/**/*.css",
    "lib/types/**/*.d.ts"
  ]
}
