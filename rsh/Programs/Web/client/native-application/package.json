{
  "name": "@redspark/rsh-client-native-application",
  "description": "Native Web conversation over the selected Session authority",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/native-application"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./controller": {
      "types": "./lib/types/controller.d.ts",
      "default": "./lib/controller.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "client"
      ],
      "requires": [
        "clientNativeSession",
        "clientNativeWorkspace",
        "clientNativeDirectoryPicker",
        "clientSlots",
        "clientLocale",
        "clientNativeTheme"
      ],
      "optional": [],
      "provides": [
        "clientApplication",
        "clientNativeConversation"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/controller.js",
    "lib/controller-*.js",
    "lib/native-*.js",
    "lib/*.css",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-client-ui-attachment": "workspace:^",
    "@redspark/rsh-client-ui-goal": "workspace:^",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "@redspark/rsh-client-ui-trajectory": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-client-ui-workflow-run": "workspace:^"
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-client-native-session": "workspace:^",
    "@redspark/rsh-native-model-selection": "workspace:^",
    "@redspark/rsh-client-ui-tool": "workspace:^",
    "@redspark/rsh-client-ui-approval": "workspace:^",
    "@redspark/rsh-client-ui-user-questions": "workspace:^",
    "@redspark/rsh-tool-todo": "workspace:^"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "@types/react": "~18.3.1",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-client-native-session": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "@redspark/rsh-authorization": "workspace:^",
    "@redspark/rsh-client-ui-renderer": "workspace:^",
    "@redspark/rsh-client-locale": "workspace:^",
    "@redspark/rsh-client-ui-slots": "workspace:^",
    "@redspark/rsh-client-ui-session": "workspace:^",
    "@redspark/rsh-client-ui-layout": "workspace:^",
    "@redspark/rsh-client-ui-sidebar": "workspace:^",
    "@redspark/rsh-client-ui-sidebar-right": "workspace:^",
    "@redspark/rsh-client-ui-theme": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-llm-pi-ai": "workspace:^",
    "@redspark/rsh-native-model-selection": "workspace:^",
    "@redspark/rsh-settings": "workspace:^",
    "@redspark/rsh-client-ui-approval": "workspace:^",
    "@redspark/rsh-client-ui-user-questions": "workspace:^",
    "@redspark/rsh-client-ui-tool": "workspace:^",
    "@redspark/rsh-tool-todo": "workspace:^",
    "@redspark/rsh-util-crypto": "workspace:^"
  }
}
