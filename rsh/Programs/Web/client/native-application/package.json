{
  "name": "@deepseek-ai/dsh-client-native-application",
  "description": "Native Web conversation over the selected Session authority",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "rsh/Programs/Web/client/native-application"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "client"
      ],
      "requires": [
        "clientNativeSession"
      ],
      "optional": [],
      "provides": [
        "clientApplication"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/native-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-native-runtime": "workspace:^",
    "@deepseek-ai/dsh-client-native-session": "workspace:^"
  },
  "scripts": {
    "bundle": "tsdown"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-native-model-selection": "workspace:^",
    "@deepseek-ai/dsh-agent-presets": "workspace:^",
    "@deepseek-ai/dsh-tool-todo": "workspace:^"
  },
  "devDependencies": {
    "react": "^18.2.0",
    "@types/react": "~18.3.1",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:^",
    "@deepseek-ai/dsh-native-model-selection": "workspace:^",
    "@deepseek-ai/dsh-agent-presets": "workspace:^",
    "@deepseek-ai/dsh-tool-todo": "workspace:^"
  }
}
