{
  "name": "@redspark/rsh-client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./tool-renderer": {
      "types": "./lib/types/tool-renderer.d.ts",
      "default": "./lib/tool-renderer.js"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@redspark/rsh-api-workspace-controller",
        "@redspark/rsh-client-connection",
        "@redspark/rsh-client-locale",
        "@redspark/rsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-client-ui-conversation": "workspace:^",
    "@redspark/rsh-client-locale": "workspace:^",
    "react": "^18.2.0",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "@redspark/rsh-util-workspace-path": "workspace:^",
    "@redspark/rsh-spill-policy": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-spill-policy": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-spill": "workspace:^",
    "@redspark/rsh-code-runtime-worker-thread": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-api-remotes": "workspace:^",
    "@redspark/rsh-client-connection": "workspace:^",
    "@redspark/rsh-client-locale": "workspace:^",
    "@redspark/rsh-client-test-runtime": "workspace:^",
    "@redspark/rsh-client-ui-conversation": "workspace:^",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@redspark/rsh-api-workspace-controller": "workspace:^",
    "@redspark/rsh-client-ui-chat": "workspace:^",
    "@redspark/rsh-client-ui-renderer": "workspace:^",
    "@redspark/rsh-client-ui-session": "workspace:^",
    "@redspark/rsh-util-workspace-path": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/native.js",
    "lib/tool-renderer.js",
    "lib/**/*.css",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "clsx": "^2.0.0",
    "@redspark/rsh-client-ui-slots": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    }
  }
}
