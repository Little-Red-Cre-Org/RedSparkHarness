{
  "name": "@redspark/rsh-client-hmr",
  "description": "Dev-only hot-reload driver for script-loaded client entries: SSE rebuilt frames → invalidate/prefetch → fiber swap through the vendored Loader entry",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/hmr"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@redspark/rsh-client-modules"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@redspark/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-client-modules": "workspace:^",
    "@redspark/rsh-http-routes": "workspace:^",
    "@redspark/rsh-http-routes-cordis": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
