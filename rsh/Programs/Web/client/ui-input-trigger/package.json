{
    "name":  "@redspark/rsh-client-ui-input-trigger",
    "description":  "Input trigger pipeline: \u0027/\u0027 and \u0027@\u0027 detection, candidate menu, pick routing to registered sources",
    "version":  "1.0.0",
    "publishConfig":  {
                          "access":  "public"
                      },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
                       "directory":  "rsh/Programs/Web/client/ui-input-trigger"
                   },
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "types":  "./lib/types/client/index.d.ts",
                                     "default":  "./lib/client.js"
                                 },
                    "./native":  {
                                     "types":  "./lib/types/native.d.ts",
                                     "default":  "./lib/native.js"
                                 },
                    "./src/*":  "./src/*",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "client":  {
                               "inject":  [
                                              "@redspark/rsh-api-session-controller",
                                              "@redspark/rsh-client-locale",
                                              "@redspark/rsh-client-ui-conversation",
                                              "@redspark/rsh-client-ui-renderer"
                                          ],
                               "platform":  "web"
                           },
                "native":  {
                               "apiVersion":  1,
                               "entry":  "./native",
                               "targets":  [
                                               "client"
                                           ],
                               "requires":  [
                                                "clientNativeConversation"
                                            ],
                               "optional":  [

                                            ],
                               "provides":  [
                                                "clientNativeInputTrigger"
                                            ]
                           }
            },
    "scripts":  {
                    "bundle":  "tsdown",
                    "watch":  "tsdown --watch"
                },
    "license":  "MIT",
    "peerDependencies":  {
                             "@redspark/cordis":  "workspace:^"
                         },
    "devDependencies":  {
                            "@redspark/rsh-client-locale":  "workspace:^",
                            "@redspark/rsh-client-ui-conversation":  "workspace:^",
                            "@redspark/rsh-client-ui-renderer":  "workspace:^",
                            "@redspark/rsh-client-test-runtime":  "workspace:^",
                            "@redspark/rsh-client-ui-primitives":  "workspace:^",
                            "@redspark/rsh-client-ui-slots":  "workspace:^",
                            "@types/react":  "~18.3.1",
                            "@redspark/cordis":  "workspace:^",
                            "react":  "^18.2.0",
                            "@redspark/rsh-file-reference":  "workspace:^",
                            "@redspark/rsh-api-session-controller":  "workspace:^",
                            "@redspark/rsh-client-store":  "workspace:^",
                            "@redspark/rsh-session":  "workspace:^",
                            "@redspark/rsh-client-ui-session":  "workspace:^",
                            "clsx":  "^2.0.0",
                            "@redspark/rsh-native-runtime":  "workspace:^"
                        },
    "files":  [
                  "lib/index.js",
                  "lib/client.js",
                  "lib/native.js",
                  "lib/types/**/*.d.ts"
              ]
}
