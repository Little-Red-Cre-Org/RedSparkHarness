{
  "name": "@redspark/rsh-client-modules",
  "description": "Client module system, dual-face: node half composes the __RSH_BOOT__ entry graph (incremental dsh.client scan, bundle route, index tap, webPlugins service); browser half is the lazy-CJS module table the vendored cordis Loader consumes as its internal seam",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/modules"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./native": {
      "types": "./lib/types/client/native.d.ts",
      "default": "./lib/native.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-http-routes": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-http-routes-cordis": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-package-manifest": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/client.js",
    "lib/native.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@redspark/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": { "optional": true }
  }
}
