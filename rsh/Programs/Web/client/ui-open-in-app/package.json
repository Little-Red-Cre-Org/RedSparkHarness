{
    "name":  "@redspark/rsh-client-ui-open-in-app",
    "description":  "Web Session-header \"Open In...\" split button opening the session workspace directory in a locally installed application",
    "version":  "1.0.0",
    "publishConfig":  {
                          "access":  "public"
                      },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
                       "directory":  "rsh/Programs/Web/client/ui-open-in-app"
                   },
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "types":  "./lib/types/client/index.d.ts",
                                     "default":  "./lib/client.js"
                                 },
                    "./native":  {
                                     "types":  "./lib/types/native.d.ts",
                                     "default":  "./lib/native.js"
                                 },
                    "./src/*":  "./src/*",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/index.js",
                  "lib/client.js",
                  "lib/native.js",
                  "lib/client/OpenInAppAction.module.css",
                  "lib/types/**/*.d.ts"
              ],
    "scripts":  {
                    "bundle":  "tsdown",
                    "watch":  "tsdown --watch"
                },
    "license":  "MIT",
    "dsh":  {
                "client":  {
                               "inject":  [
                                              "@redspark/rsh-client-locale",
                                              "@redspark/rsh-client-ui-conversation",
                                              "@redspark/rsh-client-ui-renderer",
                                              "@redspark/rsh-client-ui-session"
                                          ],
                               "platform":  "web"
                           },
                "native":  {
                               "apiVersion":  1,
                               "entry":  "./native",
                               "targets":  [
                                               "client"
                                           ],
                               "requires":  [
                                                "clientSlots",
                                                "clientLocale",
                                                "clientNativeConversation"
                                            ],
                               "optional":  [],
                               "provides":  []
                           }
            },
    "peerDependencies":  {
                             "@redspark/cordis":  "workspace:^"
                         },
    "devDependencies":  {
                            "@redspark/cordis":  "workspace:^",
                            "@redspark/rsh-api-session-controller":  "workspace:^",
                            "@redspark/rsh-client-test-runtime":  "workspace:^",
                            "@redspark/rsh-client-ui-conversation":  "workspace:^",
                            "@redspark/rsh-client-ui-renderer":  "workspace:^",
                            "@redspark/rsh-session":  "workspace:^",
                            "@types/react":  "~18.3.1",
                            "@types/react-dom":  "~18.3.0",
                            "react-dom":  "^18.2.0",
                            "@redspark/rsh-client-connection":  "workspace:^",
                            "@redspark/rsh-client-ui-slots":  "workspace:^",
                            "@redspark/rsh-client-ui-session":  "workspace:^",
                            "@redspark/rsh-client-locale":  "workspace:^",
                            "react":  "^18.2.0",
                            "@redspark/rsh-client-native-session":  "workspace:^",
                            "@redspark/rsh-native-runtime":  "workspace:^"
                        },
    "dependencies":  {
                         "@redspark/rsh-client-store":  "workspace:^",
                         "@redspark/rsh-client-ui-primitives":  "workspace:^",
                         "@redspark/rsh-host-open-in-app":  "workspace:^"
                     }
}
