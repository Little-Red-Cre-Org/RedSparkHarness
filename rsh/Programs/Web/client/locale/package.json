{
  "name": "@redspark/rsh-client-locale",
  "description": "Locale plugin: Host-backed preference, extensible language catalog, browser fallback, and typed built-in dictionaries",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/locale"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./dictionary": {
      "types": "./lib/types/dictionary.d.ts",
      "default": "./lib/dictionary.js"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@redspark/rsh-client-connection",
        "@redspark/rsh-client-ui-renderer",
        "@redspark/rsh-client-ui-settings",
        "@redspark/rsh-api-remotes"
      ],
      "platform": "web",
      "immediately": true
    },
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "client"
      ],
      "requires": [
        "clientSlots"
      ],
      "optional": [],
      "provides": [
        "clientLocale"
      ]
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-api-remotes": "workspace:^",
    "@redspark/rsh-client-store": "workspace:^",
    "@redspark/rsh-client-test-runtime": "workspace:^",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "@redspark/rsh-client-ui-renderer": "workspace:^",
    "@redspark/rsh-client-ui-settings": "workspace:^",
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@redspark/rsh-client-connection": "workspace:^",
    "@redspark/rsh-settings": "workspace:^"
  },
  "dependencies": {
    "@redspark/schemastery": "workspace:^",
    "@redspark/rsh-client-ui-slots": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/dictionary.js",
    "lib/native.js",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    }
  }
}
