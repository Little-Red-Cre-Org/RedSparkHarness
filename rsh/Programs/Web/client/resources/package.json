{
  "name": "@redspark/rsh-client-resources",
  "description": "Unified client resource model: protocol-registered providers turn URL addresses into live values, consumed through the useResource global standard hook",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/resources"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@redspark/rsh-client-ui-renderer"
      ],
      "platform": "web"
    },
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "client"
      ],
      "requires": [
        "clientSlots"
      ],
      "optional": [],
      "provides": [
        "clientNativeResources"
      ]
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-client-store": "workspace:^",
    "@redspark/rsh-client-test-runtime": "workspace:^",
    "@redspark/rsh-client-ui-renderer": "workspace:^",
    "@redspark/rsh-client-ui-slots": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/native.js",
    "lib/types/**/*.d.ts"
  ]
}
