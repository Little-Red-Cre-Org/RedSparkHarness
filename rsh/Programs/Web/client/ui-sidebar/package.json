{
  "name": "@redspark/rsh-client-ui-sidebar",
  "description": "Sidebar plugin: session multi-level tree, search, grouping, state dots",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/ui-sidebar"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@redspark/rsh-api-workspace-controller",
        "@redspark/rsh-client-ui-renderer",
        "@redspark/rsh-client-ui-layout",
        "@redspark/rsh-client-ui-session",
        "@redspark/rsh-client-ui-workspace",
        "@redspark/rsh-client-locale"
      ],
      "platform": "web"
    },
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "client"
      ],
      "requires": [
        "clientSlots",
        "clientNativeLayout",
        "clientNativeConversation",
        "clientNativeSessionPresentation",
        "clientNativeSession",
        "clientNativeSchedule",
        "clientNativeWorkspace",
        "clientNativeDirectoryPicker",
        "clientLocale"
      ],
      "optional": [],
      "provides": []
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "@redspark/rsh-client-store": "workspace:^",
    "@redspark/rsh-client-ui-layout": "workspace:^",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "@redspark/rsh-client-ui-slots": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-workspace-definition": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-api-workspace-controller": "workspace:^",
    "@redspark/rsh-client-locale": "workspace:^",
    "@redspark/rsh-client-test-runtime": "workspace:^",
    "@redspark/rsh-client-ui-renderer": "workspace:^",
    "@redspark/rsh-client-ui-theme": "workspace:^",
    "@redspark/rsh-client-ui-session": "workspace:^",
    "@redspark/rsh-client-ui-workspace": "workspace:^",
    "@redspark/rsh-client-native-session": "workspace:^",
    "@types/react": "~18.3.1",
    "@redspark/cordis": "workspace:^",
    "react": "^18.2.0",
    "clsx": "^2.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/native.js",
    "lib/client/SidebarRoot.module.css",
    "lib/types/**/*.d.ts"
  ]
}
