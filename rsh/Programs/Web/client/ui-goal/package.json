{
  "name": "@redspark/rsh-client-ui-goal",
  "description": "Session goal surface with Cordis controls and a read-only Native bar from durable events",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/ui-goal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@redspark/rsh-api-remotes",
        "@redspark/rsh-api-session-controller",
        "@redspark/rsh-client-locale",
        "@redspark/rsh-client-ui-chat",
        "@redspark/rsh-client-ui-conversation",
        "@redspark/rsh-client-ui-renderer",
        "@redspark/rsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-goal": "workspace:^",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "@redspark/rsh-session": "workspace:^",
    "@types/react": "~18.3.1"
  },
  "devDependencies": {
    "@redspark/rsh-api-remotes": "workspace:^",
    "@redspark/rsh-api-session-controller": "workspace:^",
    "@redspark/rsh-client-locale": "workspace:^",
    "@redspark/rsh-client-test-runtime": "workspace:^",
    "@redspark/rsh-client-ui-chat": "workspace:^",
    "@redspark/rsh-client-ui-conversation": "workspace:^",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "@redspark/rsh-client-ui-slots": "workspace:^",
    "@redspark/rsh-client-ui-renderer": "workspace:^",
    "@redspark/rsh-client-ui-session": "workspace:^",
    "@redspark/rsh-commands": "workspace:^",
    "@redspark/rsh-goal": "workspace:^",
    "@testing-library/react": "^16.1.0",
    "@redspark/cordis": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@redspark/rsh-typert-protocol": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/native.js",
    "lib/**/*.css",
    "lib/types/**/*.d.ts"
  ]
}
