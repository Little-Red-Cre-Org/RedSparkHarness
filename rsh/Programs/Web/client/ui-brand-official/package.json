{
    "name":  "@redspark/rsh-client-ui-brand-official",
    "description":  "Official RedSpark Harness brand occupants for the Web client\u0027s sidebar slots",
    "version":  "1.0.0",
    "publishConfig":  {
                          "access":  "public"
                      },
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
                       "directory":  "rsh/Programs/Web/client/ui-brand-official"
                   },
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "types":  "./lib/types/client/index.d.ts",
                                     "default":  "./lib/client.js"
                                 },
                    "./native":  {
                                     "types":  "./lib/types/native.d.ts",
                                     "default":  "./lib/native.js"
                                 },
                    "./src/*":  "./src/*",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "client":  {
                               "inject":  [
                                              "@redspark/rsh-client-ui-renderer",
                                              "@redspark/rsh-client-ui-sidebar"
                                          ],
                               "platform":  "web"
                           },
                "native":  {
                               "apiVersion":  1,
                               "entry":  "./native",
                               "targets":  [
                                               "client"
                                           ],
                               "requires":  [
                                                "clientSlots"
                                            ],
                               "optional":  [

                                            ],
                               "provides":  [

                                            ]
                           }
            },
    "scripts":  {
                    "bundle":  "tsdown",
                    "watch":  "tsdown --watch"
                },
    "license":  "MIT",
    "peerDependencies":  {
                             "@redspark/cordis":  "workspace:^"
                         },
    "devDependencies":  {
                            "@redspark/rsh-client-ui-primitives":  "workspace:^",
                            "@redspark/rsh-client-ui-renderer":  "workspace:^",
                            "@redspark/rsh-client-ui-sidebar":  "workspace:^",
                            "@redspark/cordis":  "workspace:^",
                            "@testing-library/react":  "^16.1.0",
                            "@types/react":  "~18.3.1",
                            "react":  "^18.2.0",
                            "react-dom":  "^18.2.0",
                            "@redspark/rsh-native-runtime":  "workspace:^"
                        },
    "files":  [
                  "lib/index.js",
                  "lib/client.js",
                  "lib/types/**/*.d.ts"
              ]
}
