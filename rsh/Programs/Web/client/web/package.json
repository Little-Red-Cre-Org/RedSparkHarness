{
  "name": "@deepseek-ai/dsh-client-web",
  "description": "Cordis-free Native browser boot API and framework-free loading page",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native-boot.d.ts",
      "default": "./lib/native-boot.js"
    },
    "./boot-page": {
      "types": "./lib/types/boot-page.d.ts",
      "default": "./lib/boot-page.js"
    },
    "./native-wire": {
      "types": "./lib/types/native-wire.d.ts"
    },
    "./base.css": "./lib/base.css",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-native-runtime": "workspace:^",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:^",
    "dequal": "2.0.3"
  },
  "devDependencies": {
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "lib/index.js",
    "lib/boot-page.js",
    "lib/**/*.css",
    "lib/native-boot.js",
    "lib/types/**/*.d.ts"
  ]
}
