{
  "name": "@redspark/rsh-client-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./native-types": {
      "types": "./lib/types/native-types.d.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./tool-records": {
      "types": "./lib/types/tool-records.d.ts",
      "default": "./lib/tool-records.js"
    },
    "./conversation-copy": {
      "types": "./lib/types/conversation-copy.d.ts",
      "default": "./lib/conversation-copy.js"
    }
  },
  "dsh": {
    "client": {
      "inject": [
        "@redspark/rsh-api-session-controller",
        "@redspark/rsh-client-file-upload",
        "@redspark/rsh-client-locale",
        "@redspark/rsh-client-ui-layout",
        "@redspark/rsh-client-ui-renderer",
        "@redspark/rsh-client-ui-session",
        "@redspark/rsh-client-ui-settings",
        "@redspark/rsh-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@redspark/schemastery": "workspace:^",
    "@redspark/rsh-client-ui-slots": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-api-remotes": "workspace:^",
    "@redspark/rsh-api-session-controller": "workspace:^",
    "@redspark/rsh-api-workspace-controller": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-client-locale": "workspace:^",
    "@redspark/rsh-client-file-upload": "workspace:^",
    "@redspark/rsh-client-store": "workspace:^",
    "@redspark/rsh-client-test-runtime": "workspace:^",
    "@redspark/rsh-client-ui-layout": "workspace:^",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "@redspark/rsh-client-ui-renderer": "workspace:^",
    "@redspark/rsh-client-ui-session": "workspace:^",
    "@redspark/rsh-client-ui-settings": "workspace:^",
    "@redspark/rsh-client-ui-workspace": "workspace:^",
    "@redspark/rsh-commands": "workspace:^",
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@redspark/rsh-goal": "workspace:^",
    "@redspark/rsh-llm-retry": "workspace:^",
    "@redspark/rsh-permission-presets": "workspace:^",
    "@redspark/rsh-plan-mode": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-token-meter": "workspace:^",
    "@redspark/rsh-tool-todo": "workspace:^",
    "@redspark/rsh-util-crypto": "workspace:^",
    "@redspark/rsh-workspace": "workspace:^",
    "@redspark/rsh-util-workspace-path": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@lexical/headless": "^0.49.0",
    "react-dom": "^18.2.0",
    "@types/react-dom": "~18.3.0",
    "zod": "^4.4.3",
    "@redspark/rsh-settings": "workspace:^",
    "lexical": "^0.49.0",
    "clsx": "^2.0.0",
    "@lexical/utils": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/history": "^0.49.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/tool-records.js",
    "lib/conversation-copy.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    }
  }
}
