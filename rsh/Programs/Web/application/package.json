{
  "name": "@redspark/rsh-web-frontend",
  "description": "Native Web application entry; dist/ contains the Cordis-free browser application",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/Web/application"
  },
  "type": "module",
  "exports": {
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "watch": "vite build --watch --no-emptyOutDir"
  },
  "license": "MIT",
  "devDependencies": {
    "@redspark/cordis-plugin-group": "workspace:^",
    "@redspark/rsh-client-modules": "workspace:^",
    "@redspark/rsh-http-routes": "workspace:^",
    "@redspark/rsh-http-routes-cordis": "workspace:^",
    "@redspark/rsh-client-store": "workspace:^",
    "@redspark/rsh-client-ui-dockkit": "workspace:^",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "@redspark/rsh-client-ui-slots": "workspace:^",
    "@redspark/rsh-client-web": "workspace:^",
    "@redspark/rsh-web-compatibility": "workspace:^",
    "@redspark/rsh-cmdline": "workspace:^",
    "@redspark/rsh-pwsh-local": "workspace:^",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "http-server": "^14.1.1",
    "fflate": "^0.8.2",
    "playwright": "^1.49.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8",
    "ws": "8.21.0",
    "@redspark/rsh-launch-environment": "workspace:^",
    "@redspark/rsh-experimental-webworker-runtime": "workspace:^"
  }
}
