{
  "name": "@redspark/rsh-acp",
  "description": "Automation-only Agent Client Protocol server for driving RedSpark Harness agents over JSON-RPC stdio",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/ACP/packages/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-mcp-client": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-token-meter": "workspace:^",
    "@redspark/rsh-user-approval": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/rsh-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-agent-loop-testkit": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-mcp-client": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-token-meter": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-user-approval": "workspace:^"
  }
}
