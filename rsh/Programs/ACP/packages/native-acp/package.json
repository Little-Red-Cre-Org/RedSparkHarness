{
  "name": "@redspark/rsh-native-acp",
  "description": "Standard ACP carrier over the native Agent and Session executor",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/ACP/packages/native-acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "fs",
        "sessionPersistence",
        "model",
        "modelExecution",
        "agents",
        "activeSessions"
      ],
      "optional": [
        "tools",
        "promptSections",
        "sandboxPolicy",
        "approval",
        "codeRuntime",
        "timeContext",
        "tmuxContext",
        "agentInstructions",
        "modelSelection",
        "sessionExecution",
        "agentPresets",
        "workspaceRegistry",
        "attachments",
        "modelDirectory",
        "commands",
        "requestContexts",
        "tokenMeter"
      ],
      "provides": [
        "application",
        "rootExecution"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/rsh-mcp-client": "workspace:^",
    "@redspark/rsh-native-headless": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-native-model-execution": "workspace:^",
    "@agentclientprotocol/sdk": "1.4.0",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-native-model-selection": "workspace:^",
    "@redspark/rsh-native-approval": "workspace:^",
    "@redspark/rsh-approval-definition": "workspace:^",
    "@redspark/rsh-commands": "workspace:^",
    "@redspark/rsh-token-meter": "workspace:^",
    "@redspark/rsh-acp-protocol": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-json-rpc-line": "workspace:^"
  }
}
