{
  "name": "@redspark/rsh-sdk-client",
  "description": "TypeScript client SDK for driving a RedSpark Harness runtime subprocess over stdio JSON-RPC: the RedSparkHarness high-level turns API and the lower-level HarnessClient",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/SDK/packages/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh": "workspace:*",
    "@redspark/rsh-home-paths": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^",
    "@redspark/rsh-sdk-runtime": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-sdk-protocol": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-sdk-protocol": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^"
  }
}
