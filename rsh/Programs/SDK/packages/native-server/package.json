{
  "name": "@redspark/rsh-native-sdk-server",
  "description": "Cordis-free SDK JSON-RPC application over native Session execution",
  "version": "1.0.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Programs/SDK/packages/native-server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./native": { "types": "./lib/types/native.d.ts", "default": "./lib/native.js" },
    "./package.json": "./package.json"
  },
  "dsh": { "native": {
    "apiVersion": 1,
    "entry": "./native",
    "targets": ["host"],
    "requires": ["fs", "sessionPersistence", "model", "modelExecution", "agents", "sessionExecution", "activeSessions", "attachments"],
    "optional": ["subagents", "tools", "promptSections", "sandboxPolicy", "approval", "codeRuntime", "timeContext", "tmuxContext", "agentInstructions", "modelSelection",
      "agentPresets", "workspaceRegistry", "commands", "requestContexts", "sessionReference"],
    "provides": ["application", "rootExecution"]
  } },
  "files": ["lib/index.js", "lib/native.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/rsh-json-rpc-line": "workspace:^",
    "@redspark/rsh-sdk-protocol": "workspace:^",
    "@redspark/rsh-native-headless": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-native-model-execution": "workspace:^",
    "@redspark/rsh-commands": "workspace:^",
    "@redspark/rsh-native-subagent": "workspace:^",
    "@redspark/rsh-approval-definition": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-attachment-local": "workspace:^",
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^"
  }
}
