    "@redspark/rsh-loader-smoke": "workspace:*",
    "@redspark/rsh-session-format": "workspace:^",
    "js-yaml": "^4.3.2",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-http-proxy": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-compaction": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-subagent": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-user-questions": "workspace:^",
    "@types/js-yaml": "^4.0.9",
    "@redspark/rsh-http-proxy": "workspace:^"
  }
