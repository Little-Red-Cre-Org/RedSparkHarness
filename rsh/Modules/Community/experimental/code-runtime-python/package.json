{
  "name": "@redspark/rsh-experimental-code-runtime-python",
  "description": "CPython subprocess implementation of the RedSpark Harness code-execution seam",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Community/experimental/code-runtime-python"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "py/**/*.py",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-code-runtime": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-code-runtime": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^"
  },
  "dependencies": {
    "@redspark/schemastery": "workspace:^"
  },
  "private": true
}
