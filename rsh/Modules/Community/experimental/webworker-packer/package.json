{
  "name": "@redspark/rsh-experimental-webworker-packer",
  "description": "Build-time packer for the browser runtime's base VFS image and ordered data-overlay archives",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Community/experimental/webworker-packer"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "dsh-pack-vfs-image": "./bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/bin.js",
    "bin.js",
    "lib/repository-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/cordis-plugin-include": "workspace:^",
    "@redspark/rsh-experimental-webworker-runtime": "workspace:^",
    "@redspark/rsh-home-paths": "workspace:^",
    "js-yaml": "^4.3.2",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@types/js-yaml": "^4.0.9",
    "@types/picomatch": "^3.0.2"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^"
  }
}
