{
  "name": "@redspark/rsh-experimental-agent-team",
  "description": "Native implicit-root Agent Teams roster, durable peer mailbox, and shared task DAG",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Community/experimental/agent-team"
  },
  "type": "module",
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "agents",
        "activeSessions",
        "sessionPersistence",
        "sessionProjections",
        "subagents"
      ],
      "optional": [],
      "provides": [
        "agentTeams"
      ]
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./native": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/rsh-native-subagent": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-subagent-protocol": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@redspark/rsh-session-persistence-jsonl": "workspace:^"
  }
}
