{
  "name": "@redspark/rsh-experimental-webworker-runtime",
  "description": "Browser-only harness runtime: in-memory VFS, module transform and loader, postMessage tunnel, and the dedicated Web Worker assembly, with the Node-compatibility layer that lets the host tree run unchanged",
  "version": "1.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Community/experimental/webworker-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": "./lib/worker.js",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-util-crypto": "workspace:^",
    "@noble/hashes": "^2.3.0",
    "@yarnpkg/parsers": "^3.1.0",
    "acorn": "^8.17.0",
    "buffer": "^6.0.3",
    "picomatch": "^4.0.4",
    "readable-stream": "^4.7.0",
    "string_decoder": "^1.3.0"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-client-connection": "workspace:^",
    "@redspark/rsh-client-modules": "workspace:^",
    "@redspark/rsh-http-routes": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-api-gateway": "workspace:^",
    "@redspark/rsh-bash-sandbox": "workspace:^",
    "@redspark/rsh-client-connection": "workspace:^",
    "@redspark/rsh-client-file-upload": "workspace:^",
    "@redspark/rsh-client-modules": "workspace:^",
    "@redspark/rsh-http-routes": "workspace:^",
    "@redspark/rsh-sandbox-local": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-subagent": "workspace:^",
    "@redspark/rsh-subprocess-local": "workspace:^",
    "@redspark/node-addon-system": "workspace:^",
    "@types/picomatch": "^3.0.2",
    "@types/readable-stream": "^4.0.24",
    "chokidar": "^5.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
