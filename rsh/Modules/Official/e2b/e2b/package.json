{
  "name": "@redspark/rsh-e2b",
  "description": "Shared E2B sandbox lifecycle for RedSpark Harness provider adapters",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/e2b/e2b"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-http-proxy": "workspace:^"
  },
  "dependencies": {
    "@redspark/schemastery": "workspace:^",
    "e2b": "2.29.1"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop-testkit": "workspace:^",
    "@redspark/rsh-app-boot": "workspace:^",
    "@redspark/rsh-bash-local": "workspace:^",
    "@redspark/rsh-fs-e2b": "workspace:^",
    "@redspark/rsh-loader-smoke": "workspace:^",
    "@redspark/rsh-lsp": "workspace:^",
    "@redspark/rsh-lsp-stdio": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-subprocess-e2b": "workspace:^",
    "@redspark/rsh-terminal": "workspace:^",
    "@redspark/rsh-terminal-bash": "workspace:^",
    "@redspark/rsh-http-proxy": "workspace:^",
    "@redspark/rsh-launch-environment": "workspace:^"
  }
}
