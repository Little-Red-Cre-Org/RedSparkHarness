{
  "name": "@redspark/rsh-e2b",
  "description": "Shared E2B sandbox lifecycle for RedSpark Harness provider adapters",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/e2b/e2b"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./owner": {
      "types": "./lib/types/owner.d.ts",
      "default": "./lib/owner.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/owner.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-http-proxy": "workspace:^"
  },
  "dependencies": {
    "e2b": "2.29.1",
    "@redspark/rsh-native-runtime": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@redspark/rsh-http-proxy": "workspace:^",
    "@redspark/rsh-launch-environment": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "zod": "^4.4.3"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [],
      "optional": [],
      "provides": [
        "e2b"
      ]
    }
  }
}
