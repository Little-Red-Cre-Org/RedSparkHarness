{
  "name": "@redspark/rsh-webhook-github",
  "description": "Signed GitHub webhook ingress for Cordis and Native trusted-rule execution",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/webhook/webhook-github"
  },
  "type": "module",
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": ["host"],
      "requires": ["httpRoutes", "credentials", "rootExecution", "webhookRules"],
      "optional": [],
      "provides": []
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-http-routes": "workspace:^",
    "@redspark/rsh-http-routes-cordis": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-webhook": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": { "optional": true },
    "@redspark/rsh-http-routes-cordis": { "optional": true }
  },
  "dependencies": {
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.4.3",
    "@octokit/webhooks": "^14.2.0"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/cordis-plugin-include": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-http-routes": "workspace:^",
    "@redspark/rsh-http-routes-cordis": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-webhook": "workspace:^"
  }
}
