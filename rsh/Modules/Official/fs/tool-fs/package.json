{
  "name": "@redspark/rsh-tool-fs",
  "description": "Model-facing filesystem tools (read, write, edit) over the RedSpark Harness filesystem seam (ctx.fs)",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/fs/tool-fs"
  },
  "type": "module",
  "dsh": {
    "runtime": {
      "apiVersion": 1,
      "role": "consumer",
      "capability": "filesystem"
    },
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "fs",
        "fsObservationPolicy",
        "tools"
      ],
      "optional": [
        "attachments",
        "model",
        "sandboxPolicy",
        "approval",
        "promptSections"
      ],
      "provides": []
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./runtime": {
      "types": "./lib/types/runtime.d.ts",
      "default": "./lib/runtime.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./image-core": {
      "types": "./lib/types/read-image-core.d.ts",
      "default": "./lib/read-image-core.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/runtime.js",
    "lib/read-image-core.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "diff": "^9.0.0",
    "@redspark/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-plugin-host": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-user-approval": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-model-execution": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-native-sandbox-policy": "workspace:^",
    "@redspark/rsh-native-approval": "workspace:^",
    "@redspark/rsh-native-prompt": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/rsh-attachment": {
      "optional": true
    },
    "@redspark/rsh-plugin-host": {
      "optional": true
    },
    "@redspark/rsh-sandbox-policy": {
      "optional": true
    },
    "@redspark/rsh-session": {
      "optional": true
    },
    "@redspark/rsh-system-prompt": {
      "optional": true
    },
    "@redspark/rsh-tools": {
      "optional": true
    },
    "@redspark/rsh-user-approval": {
      "optional": true
    },
    "@redspark/rsh-native-tools": {
      "optional": true
    },
    "@redspark/rsh-native-model-execution": {
      "optional": true
    },
    "@redspark/rsh-native-sandbox-policy": {
      "optional": true
    },
    "@redspark/rsh-native-approval": {
      "optional": true
    },
    "@redspark/rsh-native-prompt": {
      "optional": true
    },
    "@redspark/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-agent-loop-testkit": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-native-model-execution": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-fs-observation-policy": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-llm-deepseek": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-user-approval": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-code-runtime": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-native-sandbox-policy": "workspace:^",
    "@redspark/rsh-native-approval": "workspace:^",
    "@redspark/rsh-native-prompt": "workspace:^"
  }
}
