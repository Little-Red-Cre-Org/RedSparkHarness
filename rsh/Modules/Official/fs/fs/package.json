{
  "name": "@redspark/rsh-fs",
  "description": "Abstract filesystem capability seam (ctx.fs) for the RedSpark Harness — vocabulary types, the FileSystem service (text IO + optional version-guarded atomic mutations), and the fs/* policy event vocabulary",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/fs/fs"
  },
  "type": "module",
  "dsh": {
    "runtime": {
      "apiVersion": 1,
      "role": "definition",
      "capability": "filesystem"
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./runtime": {
      "types": "./lib/types/runtime-definition.d.ts",
      "default": "./lib/runtime-definition.js"
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/operations.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/runtime-definition.js",
    "lib/native.js",
    "lib/runtime.js",
    "lib/operations.js",
    "lib/types.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-plugin-host": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/rsh-invariants": { "optional": true },
    "@redspark/rsh-plugin-host": { "optional": true },
    "@redspark/cordis": { "optional": true }
  },
  "devDependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-plugin-host": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-errors": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  }
}
