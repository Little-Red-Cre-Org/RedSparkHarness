{
  "name": "@deepseek-ai/dsh-tool-code-runtime",
  "description": "Native run_code tool over the selected code runtime",
  "version": "0.1.5-rc.2",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "rsh/Modules/Official/code-runtime/tool-code-runtime" },
  "type": "module",
  "dsh": { "native": { "apiVersion": 1, "entry": "./native", "targets": ["host"], "requires": ["tools", "codeRuntime", "fs"], "optional": ["sandboxPolicy", "promptSections"], "provides": [] } },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./native": { "types": "./lib/types/native.d.ts", "default": "./lib/native.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/native.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-native-runtime": "workspace:^",
    "@deepseek-ai/dsh-native-tools": "workspace:^",
    "@deepseek-ai/dsh-native-prompt": "workspace:^",
    "@deepseek-ai/dsh-code-runtime-definition": "workspace:^",
    "@deepseek-ai/dsh-fs": "workspace:^",
    "@deepseek-ai/dsh-native-sandbox-policy": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-fs-local": "workspace:^",
    "@deepseek-ai/dsh-native-agent": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^"
  }
}
