{
  "name": "@redspark/rsh-authorization",
  "description": "Authorization seam (ctx.authorization): plugin-owned flows that obtain a credential through a conversation with the human",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/credentials/authorization"
  },
  "type": "module",
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "credentials"
      ],
      "optional": [],
      "provides": [
        "authorization"
      ]
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-invariants": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/rsh-invariants": {
      "optional": true
    },
    "@redspark/cordis": {
      "optional": true
    }
  },
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^"
  }
}
