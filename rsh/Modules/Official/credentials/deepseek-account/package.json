{
  "name": "@deepseek-ai/dsh-deepseek-account",
  "description": "Native DeepSeek Platform sign-in, profile, and balance provider",
  "version": "0.1.5-rc.2",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "rsh/Modules/Official/credentials/deepseek-account"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./native": { "types": "./lib/types/native.d.ts", "default": "./lib/native.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/native.js", "lib/shared-*.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": ["host"],
      "requires": ["credentials"],
      "optional": ["authorization"],
      "provides": ["deepseekAccount"]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-authorization": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "@deepseek-ai/dsh-native-runtime": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-authorization": { "optional": true }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-authorization": "workspace:^",
    "@deepseek-ai/dsh-credentials": "workspace:^",
    "@deepseek-ai/dsh-native-runtime": "workspace:^"
  }
}
