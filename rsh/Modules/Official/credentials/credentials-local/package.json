{
  "name": "@redspark/rsh-credentials-local",
  "description": "File-backed credentials provider ($RSH_HOME/.env under the live process environment) for the RedSpark Harness",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/credentials/credentials-local"
  },
  "type": "module",
  "dsh": {
    "runtime": { "apiVersion": 1, "role": "provider", "capability": "credentials" },
    "native": { "apiVersion": 1, "entry": "./native", "targets": ["host"], "requires": ["launchEnvironment"], "optional": [], "provides": ["credentials"] }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": { "types": "./lib/types/native.d.ts", "default": "./lib/native.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/backend.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-atomic-write": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-launch-environment": "workspace:^",
    "@redspark/rsh-home-paths": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": { "optional": true }
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "@redspark/schemastery": "workspace:^",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@redspark/rsh-atomic-write": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-launch-environment": "workspace:^",
    "@redspark/rsh-home-paths": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  }
}
