{
  "name": "@redspark/rsh-llm-deepseek",
  "description": "DeepSeek chat-completions adapter for the RedSpark Harness LLM seam",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/llm/llm-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-anonymous-user-id": "workspace:^",
    "@redspark/rsh-atomic-write": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-deepseek-llm-api-extensions": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-home-paths": "workspace:^",
    "@redspark/rsh-launch-environment": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "eventsource-parser": "^3.1.0",
    "@redspark/rsh-native-model-execution": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-anonymous-user-id": "workspace:^",
    "@redspark/rsh-atomic-write": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-attachment-local": "workspace:^",
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-deepseek-llm-api-extensions": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-home-paths": "workspace:^",
    "@redspark/rsh-launch-environment": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-plugin-package-inventory-deepseek": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-log-deepseek": "workspace:^",
    "@redspark/rsh-settings": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/rsh-http-proxy": "workspace:^"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "credentials",
        "launchEnvironment"
      ],
      "optional": [
        "attachments",
        "fs",
        "activeSessions",
        "deepseekLlmApiExtensions"
      ],
      "provides": [
        "model",
        "modelDirectory"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-compat-settings-definition": {
      "optional": true
    }
  }
}
