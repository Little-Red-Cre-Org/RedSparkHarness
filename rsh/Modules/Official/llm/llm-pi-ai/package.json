{
  "name": "@redspark/rsh-llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the RedSpark Harness LLM seam (design-verification twin of dsh-llm-deepseek)",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-authorization": "workspace:^",
    "@redspark/rsh-deepseek-account": "workspace:^",
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-launch-environment": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-settings-definition": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "@earendil-works/pi-ai": "^1.0.0",
    "@redspark/rsh-native-model-execution": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "jose": "6.2.3"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-authorization": "workspace:^",
    "@redspark/rsh-deepseek-account": "workspace:^",
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-fs": "workspace:^",
    "@redspark/rsh-launch-environment": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-llm-deepseek": "workspace:^",
    "@redspark/rsh-settings": "workspace:^",
    "@redspark/rsh-settings-definition": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/rsh-http-proxy": "workspace:^"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "credentials",
        "launchEnvironment"
      ],
      "optional": [
        "attachments",
        "fs",
        "settings",
        "authorization",
        "deepseekAccount"
      ],
      "provides": [
        "model",
        "modelDirectory",
        "modelSettings",
        "accounts"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-authorization": {
      "optional": true
    },
    "@redspark/rsh-deepseek-account": {
      "optional": true
    },
    "@redspark/rsh-compat-settings-definition": {
      "optional": true
    },
    "@redspark/rsh-settings-definition": {
      "optional": true
    }
  }
}
