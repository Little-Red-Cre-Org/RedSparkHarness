{
  "name": "@redspark/rsh-plugin-package-inventory-deepseek",
  "description": "Active Loader-backed plugin package inventory for official DeepSeek LLM API requests",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/llm/plugin-package-inventory-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": ["host"],
      "requires": ["deepseekLlmApiExtensions", "pluginInventory", "activeSessions"],
      "optional": [],
      "provides": []
    }
  },
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-presets": "workspace:^",
    "@redspark/rsh-deepseek-llm-api-extensions": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/cordis-plugin-loader": {
      "optional": true
    },
    "@redspark/rsh-agent": {
      "optional": true
    },
    "@redspark/rsh-agent-presets": {
      "optional": true
    },
    "@redspark/rsh-session": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/cordis-plugin-include": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-presets": "workspace:^",
    "@redspark/rsh-deepseek-llm-api-extensions": "workspace:^",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^"
  }
}
