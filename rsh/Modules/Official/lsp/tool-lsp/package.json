{
  "name": "@redspark/rsh-tool-lsp",
  "description": "Model-facing lsp tool over the RedSpark Harness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/types/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": ["host"],
      "requires": ["tools", "lsp", "promptSections"],
      "optional": [],
      "provides": []
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-lsp": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/rsh-tools": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-native-prompt": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-fs-local": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-lsp": "workspace:^",
    "@redspark/rsh-lsp-stdio": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-subprocess-local": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/rsh-tool-call-timeout-policy": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-native-prompt": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": { "optional": true }
  }
}
