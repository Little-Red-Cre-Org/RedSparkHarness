{
  "name": "@redspark/rsh-terminal-bash",
  "description": "Persistent shell PTY backend over the RedSpark Harness subprocess terminal primitive",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/terminal/terminal-bash"
  },
  "type": "module",
  "dsh": { "native": { "apiVersion": 1, "entry": "./native", "targets": ["host"], "requires": ["terminals", "subprocess", "sandboxPolicy"], "optional": ["sandbox"], "provides": [] } },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": { "types": "./lib/types/native.d.ts", "default": "./lib/native.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-terminal": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/rsh-agent": { "optional": true },
    "@redspark/rsh-sandbox-policy": { "optional": true },
    "@redspark/rsh-session": { "optional": true },
    "@redspark/cordis": { "optional": true },
    "@redspark/rsh-session-projection": { "optional": true }
  },
  "dependencies": {
    "@redspark/rsh-pwsh-local": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop-testkit": "workspace:^",
    "@redspark/rsh-terminal": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^",
    "@redspark/rsh-subprocess-local": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-sandbox-policy": "workspace:^"
  }
}
