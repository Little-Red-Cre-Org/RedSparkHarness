{
  "name": "@redspark/rsh-terminal",
  "description": "Persistent PTY session seam for the RedSpark Harness — owner-scoped ids, backend registry, interactive sends, reads, signals, and awaited cleanup",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/terminal/terminal"
  },
  "type": "module",
  "dsh": { "native": { "apiVersion": 1, "entry": "./native", "targets": ["host"], "requires": ["agents"], "optional": [], "provides": ["terminals"] } },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": { "types": "./lib/types/native.d.ts", "default": "./lib/native.js" },
    "./protocol": { "types": "./lib/types/protocol.d.ts", "default": "./lib/protocol.js" },
    "./error": { "types": "./lib/types/error.d.ts", "default": "./lib/error.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/protocol.js",
    "lib/error.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/rsh-agent": { "optional": true },
    "@redspark/cordis": { "optional": true }
  },
  "devDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop-testkit": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-session": "workspace:^"
  }
}
