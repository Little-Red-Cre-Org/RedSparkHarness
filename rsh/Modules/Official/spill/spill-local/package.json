{
  "name": "@redspark/rsh-spill-local",
  "description": "Local-filesystem implementation of the RedSpark Harness spill storage seam (private session-scoped files)",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/spill/spill-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-spill": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "dependencies": {
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@redspark/cordis-plugin-include": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-spill": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "dsh": {
    "runtime": {
      "apiVersion": 1,
      "role": "provider",
      "capability": "spill-storage"
    },
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [],
      "optional": [],
      "provides": [
        "spillStore"
      ]
    }
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    }
  }
}
