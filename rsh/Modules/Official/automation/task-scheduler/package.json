{
  "name": "@redspark/rsh-task-scheduler",
  "version": "1.0.0",
  "description": "Persistent scheduled Agent tasks with independent execution sessions",
  "type": "module",
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@redspark/rsh-api-remotes",
        "@redspark/rsh-client-ui-settings",
        "@redspark/rsh-client-locale",
        "@redspark/rsh-client-ui-sidebar",
        "@redspark/rsh-client-ui-workspace",
        "@redspark/rsh-client-ui-primitives"
      ]
    },
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "rootExecution",
        "activeSessions",
        "agents",
        "tools"
      ],
      "optional": [],
      "provides": [
        "taskScheduler",
        "scheduledGoalHost"
      ]
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    "./cordis.patch.yml": "./cordis.patch.yml",
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./types": {
      "types": "./lib/types/gui-types.d.ts"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/automation/task-scheduler"
  },
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-goal": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^"
  },
  "dependencies": {
    "@redspark/schemastery": "workspace:^",
    "zod": "^4.4.3",
    "@redspark/rsh-brand": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-session-execution": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-api-workspace-controller": "workspace:^",
    "@redspark/rsh-client-ui-renderer": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-presets": "workspace:^",
    "@redspark/rsh-permission-presets": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-goal": "workspace:^",
    "@redspark/rsh-goal-round-driver": "workspace:^",
    "@redspark/rsh-session-persistence": "workspace:^",
    "@redspark/rsh-session-title": "workspace:^",
    "@redspark/rsh-workspace": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/cordis-plugin-loader": "workspace:^",
    "@redspark/rsh-app-boot": "workspace:^",
    "@redspark/rsh-loader-smoke": "workspace:^",
    "@redspark/rsh-session-persistence-jsonl": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-subprocess-local": "workspace:^",
    "@redspark/rsh-sandbox-local": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-pwsh-sandbox": "workspace:^",
    "@redspark/rsh-bash-sandbox": "workspace:^",
    "@redspark/rsh-user-approval": "workspace:^",
    "@redspark/rsh-storage": "workspace:^",
    "@redspark/rsh-storage-json": "workspace:^",
    "@redspark/rsh-storage-domain": "workspace:^",
    "@redspark/rsh-typert-generator": "workspace:^",
    "@redspark/rsh-client-store": "workspace:^",
    "@redspark/rsh-client-ui-slots": "workspace:^",
    "@redspark/rsh-client-ui-settings": "workspace:^",
    "@redspark/rsh-client-locale": "workspace:^",
    "@redspark/rsh-api-remotes": "workspace:^",
    "react": "^18.2.0",
    "@types/react": "~18.3.1",
    "@redspark/rsh-client-ui-sidebar": "workspace:^",
    "@redspark/rsh-client-ui-workspace": "workspace:^",
    "@redspark/rsh-client-ui-primitives": "workspace:^",
    "@redspark/rsh-tool-goal": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-typert-protocol": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-tools": {
      "optional": true
    },
    "@redspark/rsh-typert-protocol": {
      "optional": true
    }
  }
}
