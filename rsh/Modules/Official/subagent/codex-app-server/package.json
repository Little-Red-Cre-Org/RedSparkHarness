{
  "name": "@redspark/rsh-codex-app-server",
  "description": "Official Codex app-server product Provider for Native external subagents",
  "version": "1.0.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/subagent/codex-app-server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./native": { "types": "./lib/types/native.d.ts", "default": "./lib/native.js" },
    "./wire": { "types": "./lib/types/wire.d.ts", "default": "./lib/wire.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/native.js", "lib/wire.js", "lib/shared-*.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": {
    "@redspark/rsh-json-rpc-line": "workspace:^",
    "@redspark/rsh-native-model-execution": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@openai/codex": "0.162.1",
    "eventsource-parser": "^3.1.0"
  },
  "peerDependencies": {
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-subagent": "workspace:^"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": ["host"],
      "requires": ["childConnection"],
      "optional": [],
      "provides": ["externalSubagentDriver"]
    }
  },
  "devDependencies": {
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-subagent": "workspace:^",
    "@redspark/rsh-subprocess-local": "workspace:^",
    "@redspark/rsh-util-values": "workspace:^"
  }
}
