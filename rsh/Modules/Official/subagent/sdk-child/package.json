{
  "name": "@redspark/rsh-sdk-child",
  "description": "Native Subagent adapter using the standard Native SDK child runtime",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/subagent/sdk-child"
  },
  "type": "module",
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "credentials",
        "sdkChildRuntimeLauncher"
      ],
      "optional": [
        "attachments"
      ],
      "provides": [
        "externalSubagentDriver"
      ]
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-subagent": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-sdk-protocol": "workspace:^",
    "@redspark/rsh-subagent-protocol": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-sdk-runtime": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-subagent": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-sdk-protocol": "workspace:^",
    "@redspark/rsh-subagent-protocol": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-sdk-runtime": "workspace:^"
  }
}
