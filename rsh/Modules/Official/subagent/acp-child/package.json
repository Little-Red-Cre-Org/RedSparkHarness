{
  "name": "@redspark/rsh-acp-child",
  "description": "Native external-subagent Provider using the fixed Native ACP profile",
  "version": "1.0.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/subagent/acp-child"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./native": { "types": "./lib/types/native.d.ts", "default": "./lib/native.js" },
    "./package.json": "./package.json"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": ["host"],
      "requires": ["credentials", "acpChildRuntimeLauncher"],
      "optional": ["attachments"],
      "provides": ["externalSubagentDriver"]
    }
  },
  "files": ["LICENSE-REDSPARK-RESEARCH.txt", "lib/index.js", "lib/native.js", "lib/shared-*.js", "lib/types/**/*.d.ts"],
  "license": "SEE LICENSE IN LICENSE-REDSPARK-RESEARCH.txt",
  "peerDependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@redspark/rsh-acp-protocol": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-subagent": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@redspark/rsh-acp-protocol": "workspace:^",
    "@redspark/rsh-attachment": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-subagent": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^"
  }
}
