{
  "manifest_version": 3,
  "name": "RedSpark Harness Read Only",
  "version": "0.1.0",
  "description": "Read only pages you explicitly authorize in RedSpark Harness.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RedSpark Harness"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Authorize a browser page"
    }
  }
}
