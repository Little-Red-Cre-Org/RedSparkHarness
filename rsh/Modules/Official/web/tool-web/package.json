{
  "name": "@redspark/rsh-tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the RedSpark Harness web capability seam (ctx.web)",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/web/tool-web"
  },
  "type": "module",
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "tools",
        "web"
      ],
      "optional": [
        "promptSections"
      ],
      "provides": []
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-web": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-native-prompt": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-util-values": "workspace:^",
    "@redspark/schemastery": "workspace:^",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-spill-local": "workspace:^",
    "@redspark/rsh-spill-policy": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tool-call-timeout-policy": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-web": "workspace:^",
    "@redspark/rsh-web-fetch-http": "workspace:^",
    "@redspark/rsh-web-search-exa": "workspace:^",
    "@types/turndown": "^5.0.6",
    "@redspark/rsh-scope": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-native-prompt": "workspace:^",
    "@redspark/rsh-launch-environment": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-system-prompt": {
      "optional": true
    },
    "@redspark/rsh-tools": {
      "optional": true
    },
    "@redspark/rsh-native-tools": {
      "optional": true
    },
    "@redspark/rsh-native-prompt": {
      "optional": true
    }
  }
}
