{
  "name": "@redspark/rsh-web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the RedSpark Harness web capability seam (ctx.web)",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/web/web-search-deepseek"
  },
  "type": "module",
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "web",
        "launchEnvironment"
      ],
      "optional": [
        "settings",
        "credentials"
      ],
      "provides": []
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-launch-environment": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-web": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-settings-definition": "workspace:^"
  },
  "dependencies": {
    "@redspark/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@redspark/rsh-credentials": "workspace:^",
    "@redspark/rsh-credentials-local": "workspace:^",
    "@redspark/rsh-launch-environment": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-web": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-settings": "workspace:^",
    "@redspark/rsh-http-proxy": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-settings-definition": "workspace:^",
    "@redspark/rsh-settings-file": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-agent": {
      "optional": true
    },
    "@redspark/rsh-compat-settings-definition": {
      "optional": true
    },
    "@redspark/rsh-session": {
      "optional": true
    },
    "@redspark/rsh-native-tools": {
      "optional": true
    },
    "@redspark/rsh-settings-definition": {
      "optional": true
    }
  }
}
