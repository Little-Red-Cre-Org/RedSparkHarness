{
  "name": "@deepseek-ai/dsh-ide-code-oss",
  "version": "0.1.5-rc.2",
  "description": "Native Code OSS workspace and VS Code extension host",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "rsh/Modules/Official/ide/ide-code-oss"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./package.json": "./package.json",
    "./terminal": {
      "types": "./lib/types/terminal.d.ts",
      "default": "./lib/terminal.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/types/**/*.d.ts",
    "lib/terminal.js"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-native-runtime": "workspace:^",
    "@deepseek-ai/dsh-subprocess": "workspace:^",
    "zod": "^4.4.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ws": "^8.18.3"
  },
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "subprocess"
      ],
      "optional": [],
      "provides": [
        "ide"
      ]
    }
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
