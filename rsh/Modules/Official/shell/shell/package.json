{
  "name": "@redspark/rsh-shell",
  "description": "Abstract bash executor seam (ctx.shell) for the RedSpark Harness",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/shell/shell"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-compat-settings-definition": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-settings": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-native-runtime": "workspace:^"
  }
}
