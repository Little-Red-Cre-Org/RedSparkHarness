{
  "name": "@redspark/rsh-pwsh-sandbox",
  "description": "Sandbox-consuming implementation of the RedSpark Harness PowerShell executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/shell/pwsh-sandbox"
  },
  "type": "module",
  "dsh": { "native": { "apiVersion": 1, "entry": "./native", "targets": ["host"], "requires": ["subprocess", "sandbox", "sandboxPolicy"], "optional": [], "provides": ["shell"] } },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-shell": "workspace:^",
    "@redspark/rsh-pwsh-local": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/rsh-sandbox-policy": { "optional": true },
    "@redspark/cordis": { "optional": true }
  },
  "dependencies": {
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^",
    "@redspark/rsh-native-sandbox-policy": "workspace:^",
    "@redspark/rsh-shell-sandbox-core": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-shell": "workspace:^",
    "@redspark/rsh-pwsh-local": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/rsh-sandbox-local": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-subprocess-local": "workspace:^",
    "@redspark/cordis": "workspace:^"
  }
}
