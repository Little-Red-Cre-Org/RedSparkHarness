{
  "name": "@redspark/rsh-pwsh-local",
  "description": "Local PowerShell implementation of the RedSpark Harness bash executor seam",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/shell/pwsh-local"
  },
  "type": "module",
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "subprocess"
      ],
      "optional": [],
      "provides": [
        "shell"
      ]
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./resolve": {
      "types": "./lib/types/resolve.d.ts",
      "default": "./lib/resolve.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/resolve.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@redspark/rsh-shell": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/cordis": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-compat-settings-definition": {
      "optional": true
    }
  },
  "dependencies": {
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-shell-process-local": "workspace:^",
    "@redspark/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-compat-settings-definition": "workspace:^",
    "@redspark/rsh-shell": "workspace:^",
    "@redspark/rsh-subprocess": "workspace:^",
    "@redspark/rsh-subprocess-local": "workspace:^",
    "@redspark/rsh-timeout": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-settings": "workspace:^"
  }
}
