{
  "name": "@redspark/rsh-tool-pwsh",
  "description": "Model-facing pwsh tool over the bash executor seam",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/shell/tool-pwsh"
  },
  "type": "module",
  "dsh": { "native": { "apiVersion": 1, "entry": "./native", "targets": ["host"], "requires": ["shell", "tools", "shellEnv"], "optional": ["sandboxPolicy", "approval", "jobs", "jobControls"], "provides": [] } },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-jobs": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-shell": "workspace:^",
    "@redspark/rsh-shell-env": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-user-approval": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": { "optional": true },
    "@redspark/rsh-agent": { "optional": true },
    "@redspark/rsh-jobs": { "optional": true },
    "@redspark/rsh-sandbox-policy": { "optional": true },
    "@redspark/rsh-system-prompt": { "optional": true },
    "@redspark/rsh-user-approval": { "optional": true },
    "@redspark/rsh-tools": { "optional": true }
  },
  "dependencies": {
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-native-jobs": "workspace:^",
    "@redspark/rsh-native-tool-jobs": "workspace:^",
    "@redspark/rsh-shell-env": "workspace:^",
    "@redspark/rsh-native-sandbox-policy": "workspace:^",
    "@redspark/rsh-native-approval": "workspace:^",
    "@redspark/rsh-pwsh-local": "workspace:^",
    "@redspark/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-app-boot": "workspace:^",
    "@redspark/rsh-jobs": "workspace:^",
    "@redspark/rsh-jobs-local": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-loader-smoke": "workspace:^",
    "@redspark/rsh-pwsh-local": "workspace:^",
    "@redspark/rsh-sandbox": "workspace:^",
    "@redspark/rsh-sandbox-policy": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-shell": "workspace:^",
    "@redspark/rsh-shell-env": "workspace:^",
    "@redspark/rsh-subprocess-local": "workspace:^",
    "@redspark/rsh-system-prompt": "workspace:^",
    "@redspark/rsh-tool-jobs": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/rsh-user-approval": "workspace:^"
  }
}
