{
  "name": "@deepseek-ai/dsh-tool-groups",
  "description": "Native on-demand tool groups with durable Session grants",
  "version": "0.1.5-rc.2",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "rsh/Modules/Official/guard/tool-groups" },
  "type": "module",
  "dsh": { "native": { "apiVersion": 1, "entry": "./native", "targets": ["host"], "requires": ["tools", "activeSessions"], "optional": [], "provides": [] } },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./native": { "types": "./lib/types/native.d.ts", "default": "./lib/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-native-runtime": "workspace:^",
    "@deepseek-ai/dsh-native-tools": "workspace:^",
    "@deepseek-ai/dsh-native-session-execution": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-native-agent": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-native-headless": "workspace:^",
    "@deepseek-ai/dsh-native-model-execution": "workspace:^",
    "@deepseek-ai/dsh-native-prompt": "workspace:^",
    "@deepseek-ai/dsh-native-code-runtime": "workspace:^",
    "@deepseek-ai/dsh-tool-code-runtime": "workspace:^",
    "@deepseek-ai/dsh-fs-local": "workspace:^",
    "@deepseek-ai/dsh-fs-observation-policy": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:^"
  }
}
