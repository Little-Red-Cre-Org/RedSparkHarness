{
  "name": "@redspark/rsh-repeat-tool-reminder",
  "description": "Repeat-tool-call guard plugin: advisory reminders when an agent loops on identical tool calls",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Modules/Official/guard/repeat-tool-reminder"
  },
  "type": "module",
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [
        "tools"
      ],
      "optional": [],
      "provides": []
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@redspark/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^"
  },
  "devDependencies": {
    "@redspark/rsh-agent": "workspace:^",
    "@redspark/rsh-agent-loop": "workspace:^",
    "@redspark/rsh-agent-loop-testkit": "workspace:^",
    "@redspark/rsh-llm": "workspace:^",
    "@redspark/rsh-session": "workspace:^",
    "@redspark/rsh-tools": "workspace:^",
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-session-projection": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^",
    "@redspark/rsh-native-tools": "workspace:^",
    "@redspark/rsh-native-agent": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/rsh-agent": {
      "optional": true
    },
    "@redspark/rsh-tools": {
      "optional": true
    },
    "@redspark/cordis": {
      "optional": true
    },
    "@redspark/rsh-session": {
      "optional": true
    },
    "@redspark/rsh-native-runtime": {
      "optional": true
    },
    "@redspark/rsh-native-tools": {
      "optional": true
    },
    "@redspark/rsh-native-agent": {
      "optional": true
    }
  }
}
