{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "composite": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@redspark/cordis": ["./cordis.d.ts"],
      "@fixture/mixed": ["./packages/mixed/src/index.ts"],
      "@fixture/mixed/*": ["./packages/mixed/src/*"]
    },
    "skipLibCheck": true
  }
}
