{
  "name": "@redspark/rsh-launch-environment",
  "description": "Immutable RedSpark Harness launch environment that records which layer supplied each value",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Core/util/launch-environment"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/native.d.ts",
      "default": "./lib/native.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./layers": {
      "types": "./lib/types/layers.d.ts",
      "default": "./lib/layers.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/native.js",
    "lib/layers.js",
    "lib/shared-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@redspark/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redspark/cordis": "workspace:^",
    "@redspark/rsh-native-runtime": "workspace:^"
  },
  "dependencies": {
    "@redspark/rsh-home-paths": "workspace:^"
  }
}
