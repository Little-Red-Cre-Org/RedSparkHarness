{
  "name": "@redspark/rsh-http-routes",
  "description": "Framework-neutral HTTP route definitions and shared route registry",
  "version": "1.0.0",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Little-Red-Cre-Org/RedSparkHarness.git",
    "directory": "rsh/Core/util/http-routes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./host": { "types": "./lib/types/host.d.ts", "default": "./lib/host.js" },
    "./client": { "types": "./lib/types/client.d.ts", "default": "./lib/client.js" },
    "./native": { "types": "./lib/types/native.d.ts", "default": "./lib/native.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/host.js", "lib/native.js", "lib/shared-*.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": { "@redspark/rsh-native-runtime": "workspace:^" },
  "peerDependenciesMeta": { "@redspark/rsh-native-runtime": { "optional": true } },
  "devDependencies": { "@redspark/rsh-native-runtime": "workspace:^" }
}
