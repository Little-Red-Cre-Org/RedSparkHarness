{
  // Client-side typecheck aggregate: rsh/Programs/Web/client tests and top-level Client benchmarks.
  // Split from the host aggregate because both sides merge cordis Context
  // under the same keys (sessions, loader) with different services; shared
  // leaves (session/llm/tools/...) build once and are referenced by
  // both programs through each client package's own references.
  "extends": "./tsconfig.base.client.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    // Tests execute under vitest on node (e2e files spawn processes); browser
    // purity of package src is each package's own tsconfig plus
    // rsh/Scripts/client-bundle-purity.spec.ts.
    "types": ["node"]
  },
  "include": [
    "rsh/Scripts/workspace-manifest-globs.ts",
    // Source-subpath test imports can arrive through workspace links whose
    // realpath semantics vary by host. Load package CSS declarations directly.
    "rsh/Programs/Web/client/*/src/css-modules.d.ts",
    "rsh/Programs/Web/client/*/tests/**/*.ts",
    "rsh/Programs/Web/client/*/tests/**/*.tsx",
    "rsh/Tests/benchmarks/**/*.client.ts",
    "rsh/Tests/benchmarks/**/*.client.tsx",
    "rsh/Tests/benchmarks/support/**/*.ts",
    "rsh/Core/*/*/tests/**/*.client.spec.ts",
    "rsh/Core/*/*/tests/**/*.client.spec.tsx",
    "rsh/Core/*/*/tests/**/*.client.tsx",
    "rsh/Core/*/*/tests/**/*.client.ts",
    "rsh/Engine/*/*/tests/**/*.client.spec.ts",
    "rsh/Engine/*/*/tests/**/*.client.spec.tsx",
    "rsh/Engine/*/*/tests/**/*.client.tsx",
    "rsh/Engine/*/*/tests/**/*.client.ts",
    "rsh/Modules/Official/*/*/tests/**/*.client.spec.ts",
    "rsh/Modules/Official/*/*/tests/**/*.client.spec.tsx",
    "rsh/Modules/Official/*/*/tests/**/*.client.tsx",
    "rsh/Modules/Official/*/*/tests/**/*.client.ts",
    "rsh/Modules/Community/*/*/tests/**/*.client.spec.ts",
    "rsh/Modules/Community/*/*/tests/**/*.client.spec.tsx",
    "rsh/Modules/Community/*/*/tests/**/*.client.tsx",
    "rsh/Modules/Community/*/*/tests/**/*.client.ts",
    "rsh/Compatibility/DSH/*/*/tests/**/*.client.spec.ts",
    "rsh/Compatibility/DSH/*/*/tests/**/*.client.spec.tsx",
    "rsh/Compatibility/DSH/*/*/tests/**/*.client.tsx",
    "rsh/Compatibility/DSH/*/*/tests/**/*.client.ts",
    "rsh/Programs/ACP/packages/*/tests/**/*.client.spec.ts",
    "rsh/Programs/ACP/packages/*/tests/**/*.client.spec.tsx",
    "rsh/Programs/ACP/packages/*/tests/**/*.client.tsx",
    "rsh/Programs/ACP/packages/*/tests/**/*.client.ts",
    "rsh/Programs/SDK/packages/*/tests/**/*.client.spec.ts",
    "rsh/Programs/SDK/packages/*/tests/**/*.client.spec.tsx",
    "rsh/Programs/SDK/packages/*/tests/**/*.client.tsx",
    "rsh/Programs/SDK/packages/*/tests/**/*.client.ts",
    "rsh/Programs/Web/api/*/tests/**/*.client.spec.ts",
    "rsh/Programs/Web/api/*/tests/**/*.client.spec.tsx",
    "rsh/Programs/Web/api/*/tests/**/*.client.tsx",
    "rsh/Programs/Web/api/*/tests/**/*.client.ts",
    "rsh/Programs/Web/client/*/tests/**/*.client.spec.ts",
    "rsh/Programs/Web/client/*/tests/**/*.client.spec.tsx",
    "rsh/Programs/Web/client/*/tests/**/*.client.tsx",
    "rsh/Programs/Web/client/*/tests/**/*.client.ts",
    "rsh/Programs/Web/host/*/tests/**/*.client.spec.ts",
    "rsh/Programs/Web/host/*/tests/**/*.client.spec.tsx",
    "rsh/Programs/Web/host/*/tests/**/*.client.tsx",
    "rsh/Programs/Web/host/*/tests/**/*.client.ts",
    "rsh/Tests/test-support/*/tests/**/*.client.spec.ts",
    "rsh/Tests/test-support/*/tests/**/*.client.spec.tsx",
    "rsh/Tests/test-support/*/tests/**/*.client.tsx",
    "rsh/Tests/test-support/*/tests/**/*.client.ts",
    // Client package outside rsh/Programs/Web/client with a local CSS module face.
    "rsh/Modules/Official/extensions/ui-cordis/src/css-modules.d.ts",
    "rsh/Programs/Web/client/tsdown.client.ts",
    "rsh/Scripts/client-build-environment.ts",
    "rsh/Scripts/*.client.spec.ts",
    "rsh/Scripts/client-bundle-css.spec.ts",
    "rsh/Scripts/client-bundle-purity.spec.ts"
  ],
  // A `*.host.spec.ts` covers the Host half of a split client package and
  // belongs to the host aggregate, which excludes this program's `*.client.*`
  // in turn. `exclude` wins over `include`, so the test glob above stays broad.
  "exclude": [
    "rsh/Programs/Web/client/*/tests/**/*.host.spec.ts"
  ],
  "references": [
    { "path": "./rsh/Engine/core/native-agent/tsconfig.client.json" },
    { "path": "./rsh/Engine/core/native-session-execution/tsconfig.client.json" },
    { "path": "./rsh/Engine/session/session-persistence/tsconfig.client.json" },
    { "path": "./rsh/Engine/preset/agent-presets/tsconfig.client.json" },
    { "path": "./rsh/Modules/Official/workspace/workspace/tsconfig.client.json" },
    { "path": "./rsh/Engine/core/native-tools/tsconfig.client.json" },
    {"path":"./rsh/Modules/Official/automation/task-scheduler/tsconfig.client.json"},
    // Producer-to-UI spill tests execute the real nested dispatch worker.
    { "path": "./rsh/Modules/Official/code-runtime/code-runtime-worker-thread" },
    // Shared leaf: web e2e boots the real host webserver (fixture + real-host
    // smoke policy). webserver has zero workspace deps and no cordis merge,
    // so it cannot drag host-side Context augmentation into this program.
    { "path": "./rsh/Programs/Web/host/webserver" },
    // Compaction seam: ui-chat type-imports the canonical checkpoint contract
    // from the cordis-free dsh-compaction/checkpoint leaf. Composite rootDir
    // rules make that path depend on this project reference.
    { "path": "./rsh/Engine/compaction/compaction" },
    { "path": "./rsh/Programs/Web/client/store" },
    { "path": "./rsh/Programs/Web/client/ui-slots" },
    { "path": "./rsh/Programs/Web/client/ui-attachment" },
    { "path": "./rsh/Programs/Web/client/ui-primitives" },
    { "path": "./rsh/Programs/Web/client/modules" },
    { "path": "./rsh/Modules/Community/experimental/inspector/tsconfig.client.json" },
    { "path": "./rsh/Programs/Web/client/hmr" },
    { "path": "./rsh/Programs/Web/client/connection/tsconfig.client.json" },
    { "path": "./rsh/Programs/Web/client/file-upload/tsconfig.client.json" },
    { "path": "./rsh/Core/typert/registry" },
    { "path": "./rsh/Programs/Web/api/gateway/tsconfig.client.json" },
    { "path": "./rsh/Programs/Web/api/session-controller/tsconfig.client.json" },
    { "path": "./rsh/Programs/Web/api/workspace-controller/tsconfig.client.json" },
    { "path": "./rsh/Programs/Web/api/remotes/tsconfig.client.json" },
    { "path": "./rsh/Modules/Official/extensions/cordis-client-runner" },
    { "path": "./rsh/Modules/Official/extensions/ui-cordis" },
    { "path": "./rsh/Tests/test-support/client-runtime" },
    { "path": "./rsh/Tests/test-support/remote-mock" },
    { "path": "./rsh/Programs/Web/client/ui-layout" },
    { "path": "./rsh/Programs/Web/client/ui-sidebar" },
    { "path": "./rsh/Programs/Web/client/ui-brand-official" },
    { "path": "./rsh/Programs/Web/client/ui-approval" },
    { "path": "./rsh/Programs/Web/client/ui-chat" },
    { "path": "./rsh/Programs/Web/client/ui-conversation" },
    { "path": "./rsh/Programs/Web/client/ui-pet" },
    { "path": "./rsh/Programs/Web/client/ui-tool" },
    { "path": "./rsh/Programs/Web/client/ui-deliverables/tsconfig.client.json" },
    { "path": "./rsh/Programs/Web/client/ui-workflow-run" },
    { "path": "./rsh/Programs/Web/client/ui-workspace" },
    { "path": "./rsh/Programs/Web/client/ui-input-trigger" },
    { "path": "./rsh/Programs/Web/client/ui-commands" },
    { "path": "./rsh/Programs/Web/client/ui-skill" },
    { "path": "./rsh/Programs/Web/client/ui-reference" },
    { "path": "./rsh/Programs/Web/client/ui-subagent" },
    { "path": "./rsh/Modules/Community/experimental/client-ui-agent-team" },
    { "path": "./rsh/Programs/Web/client/ui-dockkit" },
    { "path": "./rsh/Programs/Web/client/ui-sidebar-right" },
    { "path": "./rsh/Programs/Web/client/ui-sidebar-documentpreview" },
    { "path": "./rsh/Programs/Web/client/ui-sidebar-files" },
    { "path": "./rsh/Programs/Web/client/ui-jobs" },
    { "path": "./rsh/Programs/Web/client/ui-schedule" },
    { "path": "./rsh/Programs/Web/client/ui-directory-picker-browse" },
    { "path": "./rsh/Programs/Web/client/ui-directory-picker-native" },
    { "path": "./rsh/Programs/Web/client/ui-goal" },
    { "path": "./rsh/Programs/Web/client/ui-message-feedback" },
    { "path": "./rsh/Programs/Web/client/ui-model-selection" },
    { "path": "./rsh/Programs/Web/client/ui-agent-preset" },
    { "path": "./rsh/Programs/Web/client/ui-permission-presets" },
    { "path": "./rsh/Programs/Web/client/ui-plan" },
    { "path": "./rsh/Programs/Web/client/ui-settings-plugins" },
    { "path": "./rsh/Programs/Web/client/ui-user-questions" },
    { "path": "./rsh/Programs/Web/client/ui-trajectory" },
    { "path": "./rsh/Engine/session-query/session-log-export/tsconfig.client.json" },
    { "path": "./rsh/Programs/Web/client/ui-open-in-app" },
    { "path": "./rsh/Programs/Web/client/ui-theme" },
    { "path": "./rsh/Programs/Web/client/ui-settings" },
