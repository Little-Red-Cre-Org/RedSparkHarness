+/* A restricted process must be able to open its own signal pipe for writing.
+   Prefer its private default-DACL capability; read-only tokens can use their
+   existing logon SID.  This changes only the new pipe, never the token or files.
+   This local experiment is not a general restricted-token compatibility layer. */
+PSID
+ipc_restricting_sid (PSID destination)
+{
+  HANDLE token;
+  if (!NT_SUCCESS (NtOpenProcessToken (GetCurrentProcess (), TOKEN_QUERY, &token)))
+    api_fatal ("signal pipe token query failed, %E");
+  DWORD size = 0;
+  NtQueryInformationToken (token, TokenRestrictedSids, NULL, 0, &size);
+  if (!size)
+    api_fatal ("signal pipe restricting SID query failed, %E");
+  PTOKEN_GROUPS groups = (PTOKEN_GROUPS) HeapAlloc (GetProcessHeap (), 0, size);
+  if (!groups || !NT_SUCCESS (NtQueryInformationToken (token, TokenRestrictedSids,
+                                                       groups, size, &size)))
+    api_fatal ("signal pipe restricting SID read failed, %E");
+  PSID selected = NULL;
+  if (groups->GroupCount)
+    {
+      size = 0;
+      NtQueryInformationToken (token, TokenDefaultDacl, NULL, 0, &size);
+      if (!size)
+        api_fatal ("signal pipe default DACL query failed, %E");
+      PTOKEN_DEFAULT_DACL info = (PTOKEN_DEFAULT_DACL)
+        HeapAlloc (GetProcessHeap (), 0, size);
+      if (!info || !NT_SUCCESS (NtQueryInformationToken (token, TokenDefaultDacl,
+                                                        info, size, &size)) || !info->DefaultDacl)
+        api_fatal ("signal pipe default DACL read failed, %E");
+      for (DWORD i = 0; i < groups->GroupCount && !selected; ++i)
+        {
+          PSID candidate = groups->Groups[i].Sid;
+          if (RtlEqualSid (candidate, well_known_world_sid))
+            continue;
+          for (DWORD j = 0; j < info->DefaultDacl->AceCount; ++j)
+            {
+              PVOID raw;
+              if (!NT_SUCCESS (RtlGetAce (info->DefaultDacl, j, &raw)))
+                api_fatal ("signal pipe ACE read failed, %E");
+              PACCESS_ALLOWED_ACE ace = (PACCESS_ALLOWED_ACE) raw;
+              if (ace->Header.AceType == ACCESS_ALLOWED_ACE_TYPE
+                  && !(ace->Header.AceFlags & INHERIT_ONLY_ACE)
+                  && ((ace->Mask & GENERIC_ALL)
+                      || (ace->Mask & FILE_ALL_ACCESS) == FILE_ALL_ACCESS)
+                  && RtlEqualSid (candidate, &ace->SidStart))
+                {
+                  selected = candidate;
+                  break;
+                }
+            }
+        }
+      HeapFree (GetProcessHeap (), 0, info);
+      if (!selected)
+        {
+          SID_IDENTIFIER_AUTHORITY nt = SECURITY_NT_AUTHORITY;
+          for (DWORD i = 0; i < groups->GroupCount; ++i)
+            {
+              PSID candidate = groups->Groups[i].Sid;
+              if (sid_sub_auth_count (candidate) == 3
+                  && sid_id_auth (candidate) == nt.Value[5]
+                  && sid_sub_auth (candidate, 0) == SECURITY_LOGON_IDS_RID)
+                {
+                  selected = candidate;
+                  break;
+                }
+            }
+        }
+      if (!selected || !NT_SUCCESS (RtlCopySid (SECURITY_MAX_SID_SIZE, destination, selected)))
+        api_fatal ("signal pipe has no usable restricting SID, %E");
+    }
+  const bool restricted = groups->GroupCount != 0;
+  HeapFree (GetProcessHeap (), 0, groups);
+  CloseHandle (token);
+  return restricted ? destination : NULL;
+}
