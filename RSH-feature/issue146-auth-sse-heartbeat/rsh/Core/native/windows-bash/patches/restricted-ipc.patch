+/* Append a capability to a caller-owned, inline IPC descriptor.  File creation
+   must not use this helper.  Existing owner and public-read ACEs are preserved. */
+void
+grant_restricted_ipc_access (PSECURITY_ATTRIBUTES attributes, size_t capacity,
+                             DWORD access)
+{
+  BYTE sid[SECURITY_MAX_SID_SIZE];
+  PSID restricted = ipc_restricting_sid (sid);
+  if (!restricted)
+    return;
+  BOOLEAN present, defaulted;
+  PACL acl;
+  if (!NT_SUCCESS (RtlGetDaclSecurityDescriptor (attributes->lpSecurityDescriptor,
+                                                &present, &acl, &defaulted))
+      || !present || !acl)
+    api_fatal ("restricted IPC requires an explicit DACL");
+  size_t extra = sizeof (ACCESS_ALLOWED_ACE) - sizeof (DWORD)
+                 + RtlLengthSid (restricted);
+  size_t expanded = acl->AclSize + extra;
+  if ((char *) acl < (char *) attributes
+      || (char *) acl + expanded > (char *) attributes + capacity
+      || expanded > USHRT_MAX)
+    api_fatal ("restricted IPC DACL capacity exceeded");
+  acl->AclSize = expanded;
+  if (!NT_SUCCESS (RtlAddAccessAllowedAce (acl, ACL_REVISION, access, restricted)))
+    api_fatal ("restricted IPC capability grant failed");
+}
+
+/* Private runtime experiment: native pipe defaults do not consistently use
+   TokenDefaultDacl.  Confined default-ACL pipes need an explicit capability.
+   Explicit caller descriptors remain unchanged.  sa_buf holds 1024 bytes. */
+PSECURITY_ATTRIBUTES
+sec_restricted_pipe (PVOID sa_buf, PSECURITY_ATTRIBUTES original)
+{
+  if (original && original->lpSecurityDescriptor)
+    return original;
+  BYTE sid[SECURITY_MAX_SID_SIZE];
+  PSID restricted = ipc_restricting_sid (sid);
+  if (!restricted)
+    return original;
+  return __sec_user (sa_buf, cygheap->user.sid (), restricted,
+                     GENERIC_READ | GENERIC_WRITE,
+                     original ? original->bInheritHandle : FALSE);
+}
