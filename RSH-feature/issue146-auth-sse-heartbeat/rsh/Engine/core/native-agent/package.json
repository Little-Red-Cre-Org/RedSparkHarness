{
  "name": "@deepseek-ai/dsh-native-agent",
  "description": "Native Agent identity, scoped lifecycle and initiator attribution",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "rsh/Engine/core/native-agent"
  },
  "type": "module",
  "dsh": {
    "native": {
      "apiVersion": 1,
      "entry": "./native",
      "targets": [
        "host"
      ],
      "requires": [],
      "optional": [],
      "provides": [
        "agents"
      ]
    }
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./native": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./inbox": {
      "types": "./lib/types/inbox.d.ts",
      "default": "./lib/inbox.js"
    },
    "./definition": {
      "types": "./lib/types/definition.d.ts"
    },
    "./turn-boundary": {
      "types": "./lib/types/turn-boundary.d.ts",
      "default": "./lib/turn-boundary.js"
    },
    "./consumed-work": {
      "types": "./lib/types/consumed-work.d.ts",
      "default": "./lib/consumed-work.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/inbox.js",
    "lib/consumed-work.js",
    "lib/turn-boundary.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-native-runtime": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-projection": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "zod": "^4.4.3"
  }
}
