{
  "name": "@deepseek-ai/dsh-root",
  "version": "0.1.5-rc.2",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "rsh/Core/vendor/*",
    "rsh/Core/identity/*",
    "rsh/Core/native/system",
    "rsh/Core/native/system/packages/*",
    "rsh/Core/runtime-diagnostics/*",
    "rsh/Core/settings/*",
    "rsh/Core/storage/*",
    "rsh/Core/subprocess/*",
    "rsh/Core/typert/*",
    "rsh/Core/util/*",
    "rsh/Engine/*/*",
    "rsh/Modules/Official/*/*",
    "rsh/Modules/Community/*/*",
    "rsh/Compatibility/DSH/*/*",
    "rsh/Programs/CLI",
    "rsh/Programs/TUI/*",
    "rsh/Programs/Desktop",
    "rsh/Programs/DesktopHost",
    "rsh/Programs/ACP/packages/*",
    "rsh/Programs/SDK/packages/*",
    "rsh/Programs/SDK/python/sdk-runtime",
    "rsh/Programs/Web/application",
    "rsh/Programs/Web/api/*",
    "rsh/Programs/Web/client/*",
    "rsh/Programs/Web/host/*",
    "rsh/Tests/test-support/*",
    "rsh/Tests/benchmarks",
    "rsh/Docs/website"
  ],
  "scripts": {
    "verify-native-dependencies": "tsx rsh/Scripts/verify-native-dependencies.ts",
    "audit-source-import-graph": "tsx rsh/Scripts/verify-source-import-graph.ts",
    "build": "tsx rsh/Scripts/build.ts",
    "build:bench": "npm run build:native-system && npm run build:lib && tsdown --config rsh/Tests/benchmarks/tsdown.config.ts",
    "build:official": "tsx rsh/Scripts/build.ts --profile official",
    "build:lib": "pnpm run build:lib:host && pnpm run build:lib:client",
    "build:lib:host": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc -b tsconfig.host.json && tsdown --env.DSH_BUILD_FACE host",
    "build:lib:client": "tsc -b tsconfig.client.json && tsdown --env.DSH_BUILD_FACE client",
    "build:web": "pnpm --filter @deepseek-ai/dsh-web-frontend run build",
    "build:desktop": "pnpm --filter @deepseek-ai/dsh-desktop run build",
    "dev:desktop": "pnpm --filter @deepseek-ai/dsh-desktop run dev",
    "start:desktop": "pnpm --filter @deepseek-ai/dsh-desktop run start",
    "prepare:desktop": "pnpm --filter @deepseek-ai/dsh-desktop run prepare:package",
    "package:desktop": "pnpm --filter @deepseek-ai/dsh-desktop run package",
    "package:desktop:dir": "pnpm --filter @deepseek-ai/dsh-desktop run package:dir",
    "package:desktop:mac:arm64": "pnpm --filter @deepseek-ai/dsh-desktop run package:mac:arm64",
    "package:desktop:mac:arm64:dir": "pnpm --filter @deepseek-ai/dsh-desktop run package:mac:arm64:dir",
    "package:desktop:mac:x64": "pnpm --filter @deepseek-ai/dsh-desktop run package:mac:x64",
    "package:desktop:mac:x64:dir": "pnpm --filter @deepseek-ai/dsh-desktop run package:mac:x64:dir",
    "package:desktop:win:x64": "pnpm --filter @deepseek-ai/dsh-desktop run package:win:x64",
    "package:desktop:win:x64:unsigned": "pnpm --filter @deepseek-ai/dsh-desktop run package:win:x64:unsigned",
    "package:desktop:win:x64:dir": "pnpm --filter @deepseek-ai/dsh-desktop run package:win:x64:dir",
    "upload:mac:arm64": "pnpm --filter @deepseek-ai/dsh-desktop run upload:mac:arm64",
    "upload:mac:x64": "pnpm --filter @deepseek-ai/dsh-desktop run upload:mac:x64",
    "upload:win:x64": "pnpm --filter @deepseek-ai/dsh-desktop run upload:win:x64",
    "clean": "tsx rsh/Scripts/clean.ts",
    "change-scope": "tsx rsh/Scripts/change-scope.ts",
    "typecheck": "npm run build:lib:host && npm run typecheck:contracts-ready",
    "typecheck:contracts-ready": "tsc -b tsconfig.client.json",
    "lint": "npm run build:lib:host && npm run lint:contracts-ready",
    "lint:contracts-ready": "tsx rsh/Scripts/run-oxlint.ts .",
    "lint:fix": "npm run build:lib:host && npm run lint:fix:contracts-ready",
    "lint:fix:contracts-ready": "tsx rsh/Scripts/run-oxlint.ts --config .oxlintrc.staged.json rsh/Core/typert/generator/tests/fixtures/type-model --fix && tsx rsh/Scripts/run-oxlint.ts . --fix",
    "duplication": "jscpd --config .jscpd.json rsh/Core rsh/Engine rsh/Modules rsh/Compatibility rsh/Programs rsh/Tests rsh/Scripts",
    "test": "pnpm run build:native-system && vitest run",
    "test:coverage": "pnpm run build:native-system && vitest run --coverage",
    "build:native-system": "tsx rsh/Core/native/system/scripts/build.ts --host-addon-only",
    "test:coverage:partitioned": "tsx rsh/Scripts/run-coverage-partitions.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:bench": "npm run build:bench && npm run build:web && npm run test:bench:built",
    "test:bench:built": "vitest run --config vitest.bench.config.ts",
    "test:expected": "vitest run --config vitest.expected.config.ts",
    "test:expected:refresh": "DSH_SNAPSHOT=refresh vitest run --config vitest.expected.config.ts",
    "test:approval-policy": "node --test .github/review-ownership/check-approval.test.mjs",
    "test:issue-management": "node .github/issue-management/policy.test.mjs",
    "test:snapshot": "vitest run --config vitest.snapshot.config.ts",
    "test:snapshot:record": "DSH_SNAPSHOT=record vitest run --config vitest.snapshot.config.ts --update",
    "test:snapshot:refresh": "DSH_SNAPSHOT=refresh vitest run --config vitest.snapshot.config.ts",
    "migrate:packed-session-fixtures": "tsx rsh/Scripts/migrate-packed-session-fixtures.ts",
    "test:web": "npm run build && npm run test:web:built",
    "test:web:refresh": "npm run build && DSH_SNAPSHOT=refresh vitest run --config vitest.web.config.ts",
    "test:web:built": "vitest run --config vitest.web.config.ts",
    "test:web:ci": "tsx rsh/Scripts/run-web-snapshots.ts",
    "test:web:perf": "npm run build && npm run test:web:perf:built",
    "test:web:perf:built": "DSH_SNAPSHOT=replay vitest run --config vitest.web.perf.config.ts",
    "test:web:stress": "npm run build && vitest run --config vitest.web-stress.config.ts",
    "benchmark:npm-resolution": "tsx rsh/Scripts/benchmark-npm-resolution.ts",
    "benchmark:npm-resolution:next": "tsx rsh/Scripts/benchmark-next-package-dependency.ts",
    "test:gui": "vitest run rsh/Programs/Web/client rsh/Programs/Web/host",
    "check:all": "tsx rsh/Scripts/run-gates.ts check-all",
    "check:ci": "tsx rsh/Scripts/run-gates.ts ci-primary",
    "check:ci:linux-primary": "tsx rsh/Scripts/run-gates.ts ci-linux-primary",
    "check:ci:static": "tsx rsh/Scripts/run-gates.ts ci-static",
    "check:ci:package-publication": "tsx rsh/Scripts/run-gates.ts ci-package-publication",
    "check:ci:lint:contracts-ready": "tsx rsh/Scripts/run-gates.ts ci-lint-contracts-ready",
    "check:ci:coverage": "tsx rsh/Scripts/run-gates.ts ci-coverage",
    "check:ci:bench": "tsx rsh/Scripts/run-gates.ts ci-bench",
    "check:ci:snapshot": "tsx rsh/Scripts/run-gates.ts ci-snapshot",
    "check:ci:artifacts": "tsx rsh/Scripts/run-gates.ts ci-artifacts",
    "check:ci:consumers": "tsx rsh/Scripts/run-gates.ts ci-consumers",
    "check:windows-wine": "bash rsh/Scripts/wine-windows-gates.sh",
    "check:ci:windows-blocking": "tsx rsh/Scripts/run-gates.ts ci-windows-blocking",
    "check:ci:windows-complete": "tsx rsh/Scripts/run-gates.ts ci-windows-complete",
    "check:ci:windows-observational": "tsx rsh/Scripts/run-gates.ts ci-windows-observational",
    "check:node-compat": "tsx rsh/Scripts/run-gates.ts node-compat",
    "publint": "tsx rsh/Scripts/publint-all.ts",
    "doc-typecheck": "npm run build:lib:host && npm run doc-typecheck:contracts-ready",
    "doc-typecheck:contracts-ready": "tsx rsh/Scripts/doc-typecheck.ts",
    "verify-md-wrap": "tsx rsh/Scripts/verify-md-wrap.ts",
    "verify-md-links": "tsx rsh/Scripts/verify-md-links.ts",
    "verify-doc-site-fragments": "tsx rsh/Scripts/verify-doc-site-fragments.ts",
    "verify-doc-site-render": "tsx rsh/Scripts/verify-doc-site-render.ts",
    "verify-public-repository-links": "tsx rsh/Scripts/verify-public-repository-links.ts",
    "verify-doc-refs": "tsx rsh/Scripts/verify-doc-refs.ts",
    "verify-subsystem-pages": "tsx rsh/Scripts/verify-subsystem-pages.ts",
    "verify-package-paths": "tsx rsh/Scripts/verify-package-paths.ts",
    "verify-package-groups": "tsx rsh/Scripts/verify-package-groups.ts",
    "verify-dsh-package-licenses": "tsx rsh/Scripts/verify-dsh-package-licenses.ts",
    "verify-config-source-ownership": "tsx rsh/Scripts/verify-config-source-ownership.ts",
    "verify-package-invariants": "tsx rsh/Scripts/verify-package-invariants.ts",
    "verify-built-package-invariants": "node rsh/Scripts/verify-built-package-invariants.mjs",
    "verify-package-readme-model-experience": "tsx rsh/Scripts/verify-package-readme-model-experience.ts",
    "verify-package-readme-summaries": "tsx rsh/Scripts/verify-package-readme-summaries.ts",
    "verify-mermaid": "tsx rsh/Scripts/verify-mermaid.ts",
    "verify-agent-note-classification": "tsx rsh/Scripts/verify-agent-note-classification.ts",
    "verify-agent-note-format": "tsx rsh/Scripts/verify-agent-note-format.ts",
    "verify-archived-agent-notes": "tsx rsh/Scripts/verify-archived-agent-notes.ts",
    "verify-type-equiv": "tsx rsh/Scripts/verify-type-equiv.ts",
    "verify-skill-invocation-metadata": "tsx rsh/Scripts/verify-skill-invocation-metadata.ts",
    "verify-translation-prompt": "tsx rsh/Scripts/verify-translation-prompt.ts",
    "verify-translation-pairing": "tsx rsh/Scripts/verify-translation-pairing.ts",
    "test:docs": "tsx rsh/Scripts/run-gates.ts doc-quick",
    "resolve-translation-pairing-conflicts": "tsx rsh/Scripts/merge-translation-pairing.ts --resolve",
    "gen-translation-brief": "tsx rsh/Scripts/gen-translation-brief.ts",
    "verify-doc-budgets": "tsx rsh/Scripts/verify-doc-budgets.ts",
    "docs:dev": "pnpm --filter @deepseek-ai/website run dev",
    "docs:build": "tsx rsh/Docs/website/build.ts && pnpm run verify-doc-site-render && pnpm run verify-doc-site-fragments",
    "docs:build:mpa": "tsx rsh/Docs/website/build.ts --mpa && pnpm run verify-doc-site-render && pnpm run verify-doc-site-fragments",
    "docs:preview": "pnpm --filter @deepseek-ai/website run preview",
    "docs:check": "pnpm exec vitest run rsh/Scripts/project-doc-site.spec.ts rsh/Scripts/verify-doc-site-fragments.spec.ts rsh/Scripts/verify-doc-site-render.spec.ts && pnpm run docs:build",
    "website:dev": "pnpm run docs:dev",
    "website:build": "pnpm run docs:build",
    "verify-package-readme-limitations": "tsx rsh/Scripts/verify-package-readme-limitations.ts",
    "verify-node-next-types": "tsx rsh/Scripts/verify-node-next-types.ts",
    "verify-optional-dependency-imports": "tsx rsh/Scripts/verify-optional-dependency-imports.ts",
    "verify-runtime-closure": "tsx rsh/Scripts/verify-runtime-closure.ts",
    "verify-application-entrypoints": "tsx rsh/Scripts/verify-application-entrypoints.ts",
    "verify-package-dependencies": "tsx rsh/Scripts/verify-package-dependencies.ts",
    "verify-npm-install-layout": "tsx rsh/Scripts/verify-npm-install-layout.ts",
    "verify-client-packages": "tsx rsh/Scripts/verify-client-packages.ts",
    "verify-client-ui-i18n": "tsx rsh/Scripts/verify-client-ui-i18n.ts",
    "verify-no-bare-dispatcher": "tsx rsh/Scripts/verify-no-bare-dispatcher.ts",
    "verify-vendored-links": "tsx rsh/Scripts/verify-vendored-links.ts",
    "verify-cordis-config": "tsx rsh/Scripts/verify-cordis-config.ts",
    "rescope-vendor": "tsx rsh/Scripts/rescope-vendor.ts",
    "rescope-vendor:check": "tsx rsh/Scripts/rescope-vendor.ts --check",
    "verify-client-domain-graph": "tsx rsh/Scripts/verify-client-domain-graph.ts",
    "gen-tsconfig-paths": "tsx rsh/Scripts/gen-tsconfig-paths.ts",
    "verify-tsconfig-paths": "tsx rsh/Scripts/gen-tsconfig-paths.ts --check",
    "gen-cordis-catalog": "tsx rsh/Scripts/gen-cordis-catalog.ts",
    "verify-cordis-catalog": "tsx rsh/Scripts/gen-cordis-catalog.ts --check",
    "gen-cordis-api": "tsx rsh/Scripts/gen-cordis-api.ts",
    "verify-cordis-api": "tsx rsh/Scripts/gen-cordis-api.ts --check",
    "gen-client-catalog": "tsx rsh/Scripts/gen-client-catalog.ts",
    "gen-cordis-inspect-catalog": "tsx rsh/Scripts/gen-cordis-inspect-catalog.ts",
    "verify-cordis-inspect-catalog": "tsx rsh/Scripts/gen-cordis-inspect-catalog.ts --check",
    "verify-client-catalog": "tsx rsh/Scripts/gen-client-catalog.ts --check",
    "verify-export-jsdoc": "tsx rsh/Scripts/verify-export-jsdoc.ts",
    "gen-tool-catalog": "tsx rsh/Scripts/gen-tool-catalog.ts",
    "verify-tool-catalog": "tsx rsh/Scripts/gen-tool-catalog.ts --check",
    "gen-config-catalog": "tsx rsh/Scripts/gen-config-catalog.ts",
    "verify-config-catalog": "tsx rsh/Scripts/gen-config-catalog.ts --check",
    "gen-doc-graphs": "tsx rsh/Scripts/gen-doc-graphs.ts",
    "verify-doc-graphs": "tsx rsh/Scripts/gen-doc-graphs.ts --check",
    "gen-persistence-catalog": "tsx rsh/Scripts/gen-persistence-catalog.ts",
    "verify-persistence-catalog": "tsx rsh/Scripts/gen-persistence-catalog.ts --check",
    "gen-session-format-catalog": "tsx rsh/Scripts/gen-session-format-catalog.ts",
    "verify-session-format-catalog": "tsx rsh/Scripts/gen-session-format-catalog.ts --check",
    "gen-third-party-notices": "tsx rsh/Scripts/gen-third-party-notices.ts",
    "verify-third-party-notices": "tsx rsh/Scripts/gen-third-party-notices.ts --check",
    "gen-module-graph": "tsx rsh/Scripts/gen-module-graph.ts",
    "gen-scoped-events": "tsx rsh/Scripts/gen-scoped-events.ts",
    "verify-scoped-events": "tsx rsh/Scripts/gen-scoped-events.ts --check",
    "verify-module-graph": "tsx rsh/Scripts/gen-module-graph.ts --check",
    "constraints": "tsx rsh/Scripts/check-workspace-constraints.ts",
    "doc-sync": "tsx rsh/Scripts/run-gates.ts doc-sync",
    "hygiene": "tsx rsh/Scripts/run-gates.ts hygiene",
    "publish:npm-baseline": "tsx rsh/Scripts/publish-npm-baseline.ts",
    "release:dsh": "tsx rsh/Scripts/release/bump.ts --family dsh",
    "release:vendor": "tsx rsh/Scripts/release/bump.ts --family vendor",
    "release:verify": "tsx rsh/Scripts/release/verify.ts",
    "release:pack": "tsx rsh/Scripts/release/pack.ts",
    "release:verify-packed-install": "tsx rsh/Scripts/release/verify-packed-install.ts",
    "release:publish": "tsx rsh/Scripts/release/publish.ts",
    "dsh": "node --import tsx/esm rsh/Programs/CLI/src/bin.ts",
    "demo:ptc": "node rsh/Scripts/demo-ptc.mjs",
    "demo:inspector": "node --import tsx/esm rsh/Programs/CLI/src/bin.ts web --patch rsh/Modules/Community/experimental/inspector/cordis.source.patch.yml",
    "mock:llm": "node --import tsx rsh/Tests/test-support/llm-mock-server/src/bin.ts",
    "dev:web": "tsx rsh/Scripts/dev-web.ts --poll",
    "postinstall": "node rsh/Scripts/install-lefthook.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-tool-session-query": "workspace:^",
    "@deepseek-ai/dsh-web-fetch-http": "workspace:^",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.0",
    "@types/spdx-expression-parse": "^4.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "@yao-pkg/pkg": "6.21.0",
    "@yarnpkg/cli-dist": "4.17.1",
    "eslint-plugin-sonarjs": "^4.1.0",
    "execa": "^10.0.0",
    "fast-check": "^4.8.0",
    "istanbul-lib-report": "^3.0.1",
    "js-yaml": "^4.3.2",
